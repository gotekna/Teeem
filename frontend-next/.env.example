# API Configuration
# For local development, point to Rails backend
NEXT_PUBLIC_API_URL=http://localhost:3000

# For production (Heroku)
# NEXT_PUBLIC_API_URL=https://teeemlive-ce8e2660a615.herokuapp.com

# Optional: Mapbox for maps
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional: Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Development only: bypass auth for testing UI
NEXT_PUBLIC_DEV_MODE_AUTH_BYPASS=false
