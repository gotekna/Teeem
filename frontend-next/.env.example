# API Configuration
# For local development, point to Rails backend
NEXT_PUBLIC_API_URL=http://localhost:3000

# For production (Heroku: teeem-production)
# NEXT_PUBLIC_API_URL=https://teeem-production-121159e1ff9d.herokuapp.com

# For beta (Heroku: teeem-beta)
# NEXT_PUBLIC_API_URL=https://teeem-beta-6e3e9cb59225.herokuapp.com

# For staging (Heroku: teeem-staging)
# NEXT_PUBLIC_API_URL=https://teeem-staging-d60a657ed68a.herokuapp.com

# Optional: Mapbox for maps
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional: Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Development only: bypass auth for testing UI
NEXT_PUBLIC_DEV_MODE_AUTH_BYPASS=false
