<!DOCTYPE html>
<html lang="en" style="background: #f0f0f0; margin: 0; padding: 0;">
<head>
  <meta charset="utf-8">
  <title>Preview</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
  </style>
</head>
<!-- Body IS the A4 page. DO NOT wrap yield_content in a div.
     Inline style blocks inside a wrapper div break iframe DOM parsing. -->
<body style="width: 210mm; min-height: 297mm; padding: 15mm 18mm; margin: 10px auto; background: white; border: 1px solid #000; font-family: Arial, sans-serif;">
  <%= yield_content %>
</body>
</html>
