<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Preview</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { margin: 0; padding: 0; }
    body {
      margin: 0;
      padding: 10px;
      background: #f0f0f0;
      font-family: Arial, sans-serif;
    }
    .a4-page {
      width: 210mm;
      min-height: 297mm;
      padding: 15mm 18mm;
      background: white;
      position: relative;
      margin: 0 auto;
      /* Black border shows exact page edge */
      border: 1px solid #000;
    }
    /* Page break line for multi-page content */
    .a4-page + .a4-page {
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="a4-page">
    <%= yield_content %>
  </div>
</body>
</html>
