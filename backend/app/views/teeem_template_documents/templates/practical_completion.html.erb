  </tr>
  <tr>
    <td>☐</td>
    <td>Energy Efficiency Certificate</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Termite Management System Documentation</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Electrical Safety Certificate</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Plumbing Compliance Certificate</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Smoke Alarm Compliance Certificate</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Appliance Manuals and Warranties</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Pool Safety Certificate (if applicable)</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>As-Built Drawings</td>
  </tr>
  <tr>
    <td>☐</td>
    <td>Keys (_________ sets provided)</td>
  </tr>
</table>

<h2>Acknowledgement</h2>

<p>
  I/We, <strong><%= @client_names %></strong>, acknowledge that:
</p>

<ul>
  <li>I/We have inspected the property with the builder</li>
  <li>The building work has reached practical completion</li>
  <li>I/We have received the handover documents listed above</li>
  <li>I/We understand my/our warranty rights and obligations</li>
</ul>

<%= render "signature_block" %>
