<% # Modern Minimal — Generous whitespace. Thin hairline dividers. Light gray accents. %>

<style>
  .po-modern {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    font-size: 9pt;
    line-height: 1.5;
    color: #2d2d2d;
  }

  .po-modern .po-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e5e5e5;
  }

  .po-modern .po-title {
    font-size: 13pt;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #666;
  }

  .po-modern .po-meta {
    text-align: right;
    font-size: 9pt;
    color: #666;
  }

  .po-modern .po-meta .po-number {
    font-size: 11pt;
    font-weight: 600;
    color: #2d2d2d;
    margin-bottom: 2px;
  }

  .po-modern .info-grid {
    display: flex;
    gap: 32px;
    margin-bottom: 24px;
    font-size: 8pt;
  }

  .po-modern .info-block {
    flex: 1;
  }

  .po-modern .info-block h4 {
    font-size: 7pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
    margin: 0 0 8px 0;
    padding-bottom: 4px;
    border-bottom: 1px solid #f0f0f0;
  }

  .po-modern .info-block p {
    margin: 3px 0;
    color: #444;
  }

  .po-modern .info-block strong {
    color: #2d2d2d;
  }

  .po-modern .line-items-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 8pt;
  }

  .po-modern .line-items-table th {
    background: transparent;
    color: #999;
    padding: 8px 10px;
    text-align: left;
    font-weight: 600;
    font-size: 7pt;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 2px solid #e5e5e5;
  }

  .po-modern .line-items-table th:nth-child(1) { width: 8%; text-align: center; }
  .po-modern .line-items-table th:nth-child(2) { width: 42%; }
  .po-modern .line-items-table th:nth-child(3) { width: 12%; }
  .po-modern .line-items-table th:nth-child(4) { width: 12%; text-align: right; }
  .po-modern .line-items-table th:nth-child(5) { width: 8%; text-align: center; }
  .po-modern .line-items-table th:nth-child(6) { width: 18%; text-align: right; }

  .po-modern .line-items-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: top;
    color: #444;
  }

  .po-modern .line-items-table td:nth-child(1) { text-align: center; }
  .po-modern .line-items-table td:nth-child(4) { text-align: right; }
  .po-modern .line-items-table td:nth-child(5) { text-align: center; }
  .po-modern .line-items-table td:nth-child(6) { text-align: right; font-weight: 500; }

  .po-modern .totals-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .po-modern .notes-box {
    flex: 1;
    margin-right: 32px;
  }

  .po-modern .notes-box h4 {
    font-size: 7pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
    margin: 0 0 8px 0;
  }

  .po-modern .totals-box {
    width: 220px;
  }

  .po-modern .totals-box table {
    width: 100%;
  }

  .po-modern .totals-box td {
    padding: 4px 0;
    color: #666;
  }

  .po-modern .totals-box td:first-child {
    text-align: right;
    padding-right: 12px;
  }

  .po-modern .totals-box td:last-child {
    text-align: right;
    font-weight: 500;
    color: #2d2d2d;
  }

  .po-modern .totals-box .total-row {
    border-top: 1px solid #e5e5e5;
    font-size: 10pt;
  }

  .po-modern .totals-box .total-row td {
    padding-top: 8px;
    font-weight: 600;
  }

  .po-modern .colour-section {
    background: #fafafa;
    border: 1px solid #f0f0f0;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 8pt;
  }

  .po-modern .colour-section h4 {
    font-size: 7pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
    margin: 0 0 8px 0;
  }

  .po-modern .colour-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .po-modern .colour-list li {
    padding: 2px 0;
    color: #444;
  }

  .po-modern .remittance-section {
    font-size: 8pt;
    margin-bottom: 20px;
    padding-top: 16px;
    border-top: 1px solid #e5e5e5;
    color: #666;
  }

  .po-modern .remittance-section h4 {
    font-size: 7pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
    margin: 0 0 8px 0;
  }

  .po-modern .conditions-section {
    font-size: 7pt;
    background: #fafafa;
    padding: 12px 16px;
    border: 1px solid #f0f0f0;
    color: #888;
  }

  .po-modern .conditions-section h4 {
    font-size: 7pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
    margin: 0 0 8px 0;
  }

  .po-modern .conditions-section ol {
    margin: 0;
    padding-left: 15px;
  }

  .po-modern .conditions-section li {
    margin-bottom: 3px;
  }

  .po-modern .delivery-note {
    font-style: italic;
    color: #999;
    font-size: 7pt;
  }
</style>

<div class="po-modern">
  <div class="po-header">
    <span class="po-title">Purchase Order</span>
    <div class="po-meta">
      <div class="po-number"><%= purchase_order[:purchase_order_number] %></div>
      <% if purchase_order[:required_date].present? %>
        <div>Delivery: <%= purchase_order[:required_date] %></div>
      <% end %>
    </div>
  </div>

  <div class="info-grid">
    <div class="info-block">
      <h4>Delivery Address</h4>
      <p><%= purchase_order[:delivery_address] || job[:full_address] %></p>
      <% if job[:suburb].present? %>
        <p><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p>
      <% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %>
        <p class="delivery-note">Lot <%= job[:lot_number] %> Plan <%= job[:plan_number] %></p>
      <% end %>
    </div>

    <div class="info-block">
      <h4>Supplier</h4>
      <p><strong><%= purchase_order[:supplier][:name] %></strong></p>
      <% if purchase_order[:supplier][:phone].present? %>
        <p><%= purchase_order[:supplier][:phone] %></p>
      <% end %>
      <% if purchase_order[:supplier][:email].present? %>
        <p><%= purchase_order[:supplier][:email] %></p>
      <% end %>
    </div>

    <div class="info-block">
      <h4>Site Contact</h4>
      <p class="delivery-note">Please ring Supervisor 3 days prior to delivery</p>
      <% if purchase_order[:site_supervisor][:name].present? %>
        <p><strong><%= purchase_order[:site_supervisor][:name] %></strong></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:email].present? %>
        <p><%= purchase_order[:site_supervisor][:email] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %>
        <p><%= purchase_order[:site_supervisor][:phone] %></p>
      <% end %>
    </div>
  </div>

  <table class="line-items-table">
    <thead>
      <tr>
        <th>Qty</th>
        <th>Description</th>
        <th>Code</th>
        <th>Rate</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each do |item| %>
        <tr>
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td><%= item[:pricebook_code] %></td>
          <td><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="totals-row">
    <div class="notes-box">
      <% if purchase_order[:special_instructions].present? %>
        <h4>Notes</h4>
        <p><%= purchase_order[:special_instructions] %></p>
      <% end %>
    </div>

    <div class="totals-box">
      <table>
        <tr>
          <td>Sub Total</td>
          <td><%= purchase_order[:subtotal] %></td>
        </tr>
        <tr>
          <td>GST</td>
          <td><%= purchase_order[:gst] %></td>
        </tr>
        <tr class="total-row">
          <td>Total</td>
          <td><%= purchase_order[:total] %></td>
        </tr>
      </table>
    </div>
  </div>

  <% if defined?(colour_selections) && colour_selections[:has_selections] %>
    <div class="colour-section">
      <h4>Colour Selections</h4>
      <ul class="colour-list">
        <% colour_selections[:flat_list].each do |selection| %>
          <li><strong><%= selection[:item].to_s.titleize %>:</strong> <%= selection[:colour] %><%= " (#{selection[:brand]})" if selection[:brand].present? %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="remittance-section">
    <h4>Remittance</h4>
    <p>
      <strong>Invoices to:</strong> <%= company[:company_name] %><br>
      <strong>Email:</strong> <%= company[:email] %> &nbsp;
      <strong>Phone:</strong> <%= company[:phone_formatted] %> &nbsp;
      <strong>Address:</strong> <%= company[:full_address] %>
    </p>
    <p><strong>Payment schedule:</strong></p>
    <ul style="margin: 5px 0; padding-left: 20px; font-size: 7pt;">
      <li><strong>7-day accounts:</strong> Invoices received before COB Wednesday will be paid the following Thursday.</li>
      <li><strong>14-day accounts:</strong> Invoices received before COB Wednesday will be paid on the Thursday two weeks later.</li>
      <li><strong>30-day accounts:</strong> Invoices received before COB on the last day of the month will be paid on the last day of the following month.</li>
    </ul>
  </div>

  <div class="conditions-section">
    <h4>Conditions of Acceptance</h4>
    <ol>
      <% (company[:po_conditions] || []).each do |condition| %>
        <li><%= condition %></li>
      <% end %>
    </ol>
  </div>
</div>
