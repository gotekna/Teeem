<% # Classic Corporate — Standard PO format. Title left, logo right, integrated info table. %>

<style>
  .po-container {
    font-family: Arial, sans-serif;
    font-size: 9pt;
    line-height: 1.3;
    color: #000;
  }

  .po-container p {
    margin: 2px 0;
  }

  .po-container ul, .po-container ol {
    margin: 3px 0;
  }

  .po-container li {
    margin-bottom: 1px;
  }

  .po-container h4 {
    margin: 0;
  }

  .po-top-bar {
    background: #0d7377;
    height: 6px;
    margin-bottom: 10px;
  }

  .po-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
  }

  .po-header-left .po-title {
    font-size: 22pt;
    font-weight: bold;
    font-style: italic;
    font-family: 'Times New Roman', Times, serif;
  }

  .po-header-left .po-task-name {
    font-size: 9pt;
    font-style: italic;
    color: #333;
    margin-top: 2px;
  }

  .po-header-right {
    text-align: right;
  }

  .po-header-right img {
    max-width: 180px;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .po-ref-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 10px;
    font-size: 9pt;
  }

  .po-ref-table td {
    border: 1px solid #000;
    padding: 3px 8px;
  }

  .po-ref-table td:nth-child(odd) {
    font-weight: bold;
    background: #f5f5f5;
  }

  .po-info-row {
    display: flex;
    gap: 0;
    margin-bottom: 10px;
    font-size: 8pt;
  }

  .po-info-box {
    flex: 1;
    border: 1px solid #000;
    padding: 6px;
  }

  .po-info-box + .po-info-box {
    border-left: none;
  }

  .po-info-box h4 {
    font-size: 8pt;
    font-weight: bold;
    text-align: center;
    margin: -6px -6px 6px -6px;
    padding: 3px;
    background: #f0f0f0;
    border-bottom: 1px solid #000;
  }

  .po-info-box p {
    margin: 2px 0;
  }

  .po-info-label {
    font-weight: bold;
    display: inline-block;
    min-width: 50px;
  }

  .delivery-note {
    font-style: italic;
    color: #333;
    font-size: 7pt;
  }

  .line-items-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 10px;
    font-size: 8pt;
  }

  .line-items-table th {
    background: #333;
    color: #fff;
    padding: 5px 6px;
    text-align: left;
    font-weight: bold;
    font-size: 8pt;
  }

  .line-items-table th:nth-child(1) { width: 7%; text-align: center; }
  .line-items-table th:nth-child(2) { width: 40%; }
  .line-items-table th:nth-child(3) { width: 12%; }
  .line-items-table th:nth-child(4) { width: 12%; text-align: right; }
  .line-items-table th:nth-child(5) { width: 8%; text-align: center; }
  .line-items-table th:nth-child(6) { width: 18%; text-align: right; }

  .line-items-table td {
    padding: 4px 6px;
    border-bottom: 1px solid #ddd;
    vertical-align: top;
  }

  .line-items-table td:nth-child(1) { text-align: center; }
  .line-items-table td:nth-child(4) { text-align: right; }
  .line-items-table td:nth-child(5) { text-align: center; }
  .line-items-table td:nth-child(6) { text-align: right; }

  .totals-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .notes-box {
    flex: 1;
    margin-right: 20px;
    font-size: 8pt;
  }

  .notes-box h4 {
    font-weight: bold;
    margin: 0 0 3px 0;
    font-size: 9pt;
    text-decoration: underline;
  }

  .totals-box {
    width: 200px;
    font-size: 9pt;
  }

  .totals-box table {
    width: 100%;
    border-collapse: collapse;
  }

  .totals-box td {
    padding: 2px 0;
    border: 1px solid #000;
  }

  .totals-box td:first-child {
    text-align: right;
    padding-right: 8px;
    font-style: italic;
  }

  .totals-box td:last-child {
    text-align: right;
    padding-right: 5px;
    font-weight: bold;
  }

  .colour-section {
    font-size: 9pt;
    margin-bottom: 8px;
  }

  .colour-section h4 {
    font-weight: bold;
    margin: 0;
    display: inline;
  }

  .colour-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .colour-list li {
    padding: 1px 0;
  }

  .remittance-section {
    font-size: 8pt;
    margin-bottom: 8px;
    border-top: 1px dashed #999;
    padding-top: 8px;
  }

  .remittance-section h4 {
    font-weight: bold;
    text-decoration: underline;
    margin: 0 0 3px 0;
  }

  .conditions-section {
    font-size: 7pt;
    margin-top: 8px;
  }

  .conditions-section h4 {
    font-weight: bold;
    text-decoration: underline;
    margin: 0 0 3px 0;
    font-size: 8pt;
  }

  .conditions-section ol {
    margin: 0;
    padding-left: 15px;
  }

  .conditions-section li {
    margin-bottom: 2px;
  }
</style>

<div class="po-container">
  <div class="po-top-bar"></div>

  <div class="po-header" style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px">
    <div class="po-header-left">
      <div class="po-title">Purchase Order</div>
      <% if purchase_order[:task_name].present? %>
        <div class="po-task-name"><%= purchase_order[:task_name] %></div>
      <% end %>
    </div>
    <div class="po-header-right">
      <% if company[:logo_url].present? %>
        <img src="<%= company[:logo_url] %>" alt="<%= company[:company_name] %>" style="max-width:180px;max-height:60px;width:auto;height:auto;object-fit:contain">
      <% else %>
        <strong style="font-size: 14pt;"><%= company[:company_name] %></strong>
      <% end %>
    </div>
  </div>

  <table class="po-ref-table">
    <tr>
      <td>PURCHASE ORDER:</td>
      <td><%= purchase_order[:purchase_order_number] %></td>
      <td>QBCC:</td>
      <td><%= company[:qbcc_license] %></td>
    </tr>
    <tr>
      <td>PROPOSED DELIVERY:</td>
      <td><%= purchase_order[:required_date] %></td>
      <td>ABN:</td>
      <td><%= company[:abn_formatted] %></td>
    </tr>
  </table>

  <div class="po-info-row" style="display:flex;gap:0;margin-bottom:10px;font-size:8pt">
    <div class="po-info-box" style="flex:1;border:1px solid #000;padding:6px">
      <h4 style="font-size:8pt;font-weight:bold;text-align:center;margin:-6px -6px 6px -6px;padding:3px;background:#f0f0f0;border-bottom:1px solid #000">DELIVERY ADDRESS</h4>
      <p><%= purchase_order[:delivery_address] || job[:full_address] %></p>
      <% if job[:suburb].present? %>
        <p><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p>
      <% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %>
        <p class="delivery-note">Lot <%= job[:lot_number] %> Plan <%= job[:plan_number] %></p>
      <% end %>
    </div>

    <div class="po-info-box" style="flex:1;border:1px solid #000;border-left:none;padding:6px">
      <h4 style="font-size:8pt;font-weight:bold;text-align:center;margin:-6px -6px 6px -6px;padding:3px;background:#f0f0f0;border-bottom:1px solid #000">SUPPLIER</h4>
      <p><strong><%= purchase_order[:supplier][:name] %></strong></p>
      <% if purchase_order[:supplier][:phone].present? %>
        <p><%= purchase_order[:supplier][:phone] %></p>
      <% end %>
      <% if purchase_order[:supplier][:email].present? %>
        <p><%= purchase_order[:supplier][:email] %></p>
      <% end %>
    </div>

    <div class="po-info-box" style="flex:1;border:1px solid #000;border-left:none;padding:6px">
      <h4 style="font-size:8pt;font-weight:bold;text-align:center;margin:-6px -6px 6px -6px;padding:3px;background:#f0f0f0;border-bottom:1px solid #000">CONTACT</h4>
      <p class="delivery-note">Please ring Supervisor 3 days prior to delivery to confirm delivery date</p>
      <% if purchase_order[:site_supervisor][:name].present? %>
        <p><span class="po-info-label">Sup:</span> <%= purchase_order[:site_supervisor][:name] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:email].present? %>
        <p><span class="po-info-label">Email:</span> <%= purchase_order[:site_supervisor][:email] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %>
        <p><span class="po-info-label">Mobile:</span> <%= purchase_order[:site_supervisor][:phone] %></p>
      <% end %>
    </div>
  </div>

  <table class="line-items-table">
    <thead>
      <tr>
        <th>QTY</th>
        <th>DESCRIPTION</th>
        <th>CODE</th>
        <th>RATE</th>
        <th>TAX</th>
        <th>AMOUNT</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each do |item| %>
        <tr>
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td><%= item[:pricebook_code] %></td>
          <td><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="totals-row" style="display:flex;justify-content:space-between;margin-bottom:10px">
    <div class="notes-box" style="flex:1;margin-right:20px;font-size:8pt">
      <h4>NOTES:</h4>
      <% if purchase_order[:special_instructions].present? %>
        <p><%= purchase_order[:special_instructions] %></p>
      <% end %>
    </div>

    <div class="totals-box">
      <table>
        <tr>
          <td>Sub Total:</td>
          <td><%= purchase_order[:subtotal] %></td>
        </tr>
        <tr>
          <td>GST:</td>
          <td><%= purchase_order[:gst] %></td>
        </tr>
        <tr>
          <td><strong>Total:</strong></td>
          <td><%= purchase_order[:total] %></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="colour-section">
    <h4>COLOUR:</h4>
    <% if defined?(colour_selections) && colour_selections[:has_selections] %>
      <ul class="colour-list">
        <% colour_selections[:flat_list].each do |selection| %>
          <li><strong><%= selection[:item].to_s.titleize %>:</strong> <%= selection[:colour] %><%= " (#{selection[:brand]})" if selection[:brand].present? %></li>
        <% end %>
      </ul>
    <% else %>
      <em>As per colour selection</em>
    <% end %>
  </div>

  <div class="remittance-section">
    <h4>REMITTANCE:</h4>
    <p>
      Invoices to: <strong><%= company[:company_name] %></strong><br>
      Email: <%= company[:email] %> &nbsp; Phone: <%= company[:phone_formatted] %> &nbsp; Address: <%= company[:full_address] %>
    </p>
    <% payment_days = purchase_order[:supplier][:payment_terms_days] %>
    <% if payment_days.present? && payment_days.to_i <= 14 %>
      <p>Payment schedule:</p>
      <ul style="margin: 3px 0; padding-left: 20px; font-size: 8pt;">
        <% if payment_days.to_i <= 7 %>
          <li><strong>7-day accounts:</strong> Invoices received before COB Wednesday will be paid the following Thursday.</li>
        <% else %>
          <li><strong>14-day accounts:</strong> Invoices received before COB Wednesday will be paid on the Thursday two weeks later.</li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="conditions-section">
    <h4>CONDITIONS OF ACCEPTANCE</h4>
    <ol>
      <% (company[:po_conditions] || []).each do |condition| %>
        <li><%= condition %></li>
      <% end %>
    </ol>
  </div>
</div>
