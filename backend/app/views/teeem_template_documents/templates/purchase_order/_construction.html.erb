<% # Construction Industry — Prominent delivery address & supervisor. Yellow safety accent. %>

<style>
  .po-construction {
    font-family: Arial, sans-serif;
    font-size: 9pt;
    line-height: 1.3;
    color: #000;
  }

  .po-construction .po-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 4px solid #f59e0b;
  }

  .po-construction .po-title {
    font-size: 18pt;
    font-weight: bold;
    letter-spacing: 1px;
  }

  .po-construction .po-badge {
    background: #f59e0b;
    color: #000;
    padding: 6px 14px;
    font-size: 12pt;
    font-weight: bold;
    display: inline-block;
  }

  .po-construction .po-date-line {
    font-size: 9pt;
    text-align: right;
    margin-top: 4px;
    color: #555;
  }

  .po-construction .delivery-hero {
    background: #fef3c7;
    border: 2px solid #f59e0b;
    padding: 12px 16px;
    margin-bottom: 12px;
    display: flex;
    gap: 20px;
    font-size: 9pt;
  }

  .po-construction .delivery-hero .address-col {
    flex: 2;
  }

  .po-construction .delivery-hero .supervisor-col {
    flex: 1;
    border-left: 2px solid #f59e0b;
    padding-left: 16px;
  }

  .po-construction .delivery-hero h4 {
    font-size: 9pt;
    font-weight: bold;
    margin: 0 0 6px 0;
    color: #92400e;
    text-transform: uppercase;
  }

  .po-construction .delivery-hero p {
    margin: 2px 0;
  }

  .po-construction .delivery-hero .site-label {
    font-weight: bold;
    display: inline-block;
    width: 55px;
    color: #92400e;
  }

  .po-construction .supplier-bar {
    background: #f5f5f5;
    border: 1px solid #ddd;
    padding: 8px 12px;
    margin-bottom: 12px;
    display: flex;
    gap: 20px;
    font-size: 8pt;
  }

  .po-construction .supplier-bar h4 {
    font-size: 8pt;
    font-weight: bold;
    margin: 0 0 3px 0;
    text-transform: uppercase;
    color: #555;
  }

  .po-construction .supplier-bar p { margin: 1px 0; }

  .po-construction .line-items-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 14px;
    font-size: 8pt;
  }

  .po-construction .line-items-table th {
    background: #78350f;
    color: #fff;
    padding: 6px 8px;
    text-align: left;
    font-weight: bold;
    font-size: 8pt;
  }

  .po-construction .line-items-table th:nth-child(1) { width: 8%; text-align: center; }
  .po-construction .line-items-table th:nth-child(2) { width: 42%; }
  .po-construction .line-items-table th:nth-child(3) { width: 12%; }
  .po-construction .line-items-table th:nth-child(4) { width: 12%; text-align: right; }
  .po-construction .line-items-table th:nth-child(5) { width: 8%; text-align: center; }
  .po-construction .line-items-table th:nth-child(6) { width: 18%; text-align: right; }

  .po-construction .line-items-table td {
    padding: 5px 8px;
    border-bottom: 1px solid #ddd;
    vertical-align: top;
  }

  .po-construction .line-items-table td:nth-child(1) { text-align: center; }
  .po-construction .line-items-table td:nth-child(4) { text-align: right; }
  .po-construction .line-items-table td:nth-child(5) { text-align: center; }
  .po-construction .line-items-table td:nth-child(6) { text-align: right; font-weight: bold; }

  .po-construction .line-items-table tr:nth-child(even) {
    background: #fefce8;
  }

  .po-construction .totals-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .po-construction .notes-box {
    flex: 1;
    margin-right: 20px;
  }

  .po-construction .notes-box h4 {
    font-weight: bold;
    font-size: 9pt;
    margin: 0 0 5px 0;
  }

  .po-construction .totals-box {
    width: 220px;
    background: #fef3c7;
    border: 2px solid #f59e0b;
    padding: 8px 10px;
  }

  .po-construction .totals-box table { width: 100%; }

  .po-construction .totals-box td {
    padding: 3px 0;
  }

  .po-construction .totals-box td:first-child {
    text-align: right;
    padding-right: 10px;
    font-weight: bold;
  }

  .po-construction .totals-box td:last-child {
    text-align: right;
    font-weight: bold;
  }

  .po-construction .totals-box .total-row {
    border-top: 3px solid #f59e0b;
    font-size: 11pt;
  }

  .po-construction .colour-section {
    background: #fffde7;
    border: 2px solid #ffc107;
    padding: 10px 14px;
    margin-bottom: 14px;
    font-size: 9pt;
  }

  .po-construction .colour-section h4 {
    font-weight: bold;
    margin: 0 0 6px 0;
    color: #78350f;
    text-transform: uppercase;
  }

  .po-construction .colour-list { margin: 0; padding-left: 0; list-style: none; }
  .po-construction .colour-list li { padding: 2px 0; }

  .po-construction .safety-notice {
    background: #fef3c7;
    border: 2px solid #f59e0b;
    padding: 8px 12px;
    margin-bottom: 14px;
    font-size: 8pt;
    font-weight: bold;
    color: #92400e;
    text-align: center;
  }

  .po-construction .remittance-section {
    font-size: 8pt;
    margin-bottom: 14px;
    border-top: 2px solid #78350f;
    padding-top: 8px;
  }

  .po-construction .remittance-section h4 {
    font-weight: bold;
    margin: 0 0 4px 0;
    color: #78350f;
  }

  .po-construction .conditions-section {
    font-size: 7pt;
    background: #f5f5f5;
    padding: 10px;
    border: 1px solid #ddd;
  }

  .po-construction .conditions-section h4 {
    font-weight: bold;
    margin: 0 0 5px 0;
    font-size: 8pt;
    color: #78350f;
  }

  .po-construction .conditions-section ol { margin: 0; padding-left: 15px; }
  .po-construction .conditions-section li { margin-bottom: 3px; }

  .po-construction .delivery-note {
    font-style: italic;
    color: #92400e;
    font-size: 7pt;
    font-weight: bold;
  }
</style>

<div class="po-construction">
  <div class="po-header">
    <span class="po-title">PURCHASE ORDER</span>
    <div>
      <span class="po-badge"><%= purchase_order[:purchase_order_number] %></span>
      <% if purchase_order[:required_date].present? %>
        <div class="po-date-line">Required on site: <strong><%= purchase_order[:required_date] %></strong></div>
      <% end %>
    </div>
  </div>

  <div class="delivery-hero">
    <div class="address-col">
      <h4>Site Delivery Address</h4>
      <p style="font-size: 10pt; font-weight: bold;"><%= purchase_order[:delivery_address] || job[:full_address] %></p>
      <% if job[:suburb].present? %>
        <p style="font-size: 10pt;"><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p>
      <% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %>
        <p class="delivery-note">Lot <%= job[:lot_number] %> Plan <%= job[:plan_number] %></p>
      <% end %>
    </div>
    <div class="supervisor-col">
      <h4>Site Supervisor</h4>
      <% if purchase_order[:site_supervisor][:name].present? %>
        <p style="font-size: 10pt; font-weight: bold;"><%= purchase_order[:site_supervisor][:name] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %>
        <p><span class="site-label">Phone:</span> <%= purchase_order[:site_supervisor][:phone] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:email].present? %>
        <p><span class="site-label">Email:</span> <%= purchase_order[:site_supervisor][:email] %></p>
      <% end %>
      <p class="delivery-note">Ring 3 days prior to delivery</p>
    </div>
  </div>

  <div class="supplier-bar">
    <div style="flex: 1;">
      <h4>Supplier</h4>
      <p><strong><%= purchase_order[:supplier][:name] %></strong></p>
      <% if purchase_order[:supplier][:phone].present? %><p>Ph: <%= purchase_order[:supplier][:phone] %></p><% end %>
    </div>
    <div style="flex: 1;">
      <h4>Contact</h4>
      <% if purchase_order[:supplier][:email].present? %><p>Email: <%= purchase_order[:supplier][:email] %></p><% end %>
    </div>
  </div>

  <table class="line-items-table">
    <thead>
      <tr>
        <th>QTY</th>
        <th>DESCRIPTION</th>
        <th>CODE</th>
        <th>RATE</th>
        <th>TAX</th>
        <th>AMOUNT</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each do |item| %>
        <tr>
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td><%= item[:pricebook_code] %></td>
          <td><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="totals-row">
    <div class="notes-box">
      <% if purchase_order[:special_instructions].present? %>
        <h4>NOTES:</h4>
        <p><%= purchase_order[:special_instructions] %></p>
      <% end %>
    </div>

    <div class="totals-box">
      <table>
        <tr><td>Sub Total:</td><td><%= purchase_order[:subtotal] %></td></tr>
        <tr><td>GST:</td><td><%= purchase_order[:gst] %></td></tr>
        <tr class="total-row"><td>TOTAL:</td><td><%= purchase_order[:total] %></td></tr>
      </table>
    </div>
  </div>

  <div class="colour-section">
    <h4>Colour Selections</h4>
    <% if defined?(colour_selections) && colour_selections[:has_selections] %>
      <ul class="colour-list">
        <% colour_selections[:flat_list].each do |selection| %>
          <li><strong><%= selection[:item].to_s.titleize %>:</strong> <%= selection[:colour] %><%= " (#{selection[:brand]})" if selection[:brand].present? %></li>
        <% end %>
      </ul>
    <% else %>
      <p>As per colour selection</p>
    <% end %>
  </div>

  <div class="safety-notice">
    ALL DELIVERIES MUST COMPLY WITH SITE SAFETY REQUIREMENTS. PPE REQUIRED ON SITE AT ALL TIMES.
  </div>

  <div class="remittance-section">
    <h4>REMITTANCE:</h4>
    <p>
      <strong>Invoices to:</strong> <%= company[:company_name] %><br>
      <strong>Email:</strong> <%= company[:email] %> &nbsp;
      <strong>Phone:</strong> <%= company[:phone_formatted] %> &nbsp;
      <strong>Address:</strong> <%= company[:full_address] %>
    </p>
    <p><strong>Payment schedule:</strong></p>
    <ul style="margin: 5px 0; padding-left: 20px; font-size: 7pt;">
      <li><strong>7-day accounts:</strong> Invoices received before COB Wednesday will be paid the following Thursday.</li>
      <li><strong>14-day accounts:</strong> Invoices received before COB Wednesday will be paid on the Thursday two weeks later.</li>
      <li><strong>30-day accounts:</strong> Invoices received before COB on the last day of the month will be paid on the last day of the following month.</li>
    </ul>
  </div>

  <div class="conditions-section">
    <h4>CONDITIONS OF ACCEPTANCE</h4>
    <ol>
      <% (company[:po_conditions] || []).each do |condition| %>
        <li><%= condition %></li>
      <% end %>
    </ol>
  </div>
</div>
