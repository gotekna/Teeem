<% # Professional Clean — Two-column header. Subtle color accents. Rounded info boxes. %>

<style>
  .po-professional {
    font-family: 'Calibri', 'Segoe UI', sans-serif;
    font-size: 9pt;
    line-height: 1.4;
    color: #333;
  }

  .po-professional .po-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 3px solid #2563eb;
  }

  .po-professional .po-title {
    font-size: 16pt;
    font-weight: 600;
    color: #2563eb;
  }

  .po-professional .po-meta-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 8px 14px;
    text-align: right;
    font-size: 8pt;
  }

  .po-professional .po-meta-box .po-number {
    font-size: 12pt;
    font-weight: 700;
    color: #2563eb;
    margin-bottom: 2px;
  }

  .po-professional .po-meta-box .po-date {
    color: #666;
  }

  .po-professional .info-grid {
    display: flex;
    gap: 14px;
    margin-bottom: 18px;
    font-size: 8pt;
  }

  .po-professional .info-panel {
    flex: 1;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 10px 12px;
  }

  .po-professional .info-panel h4 {
    font-size: 7pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #2563eb;
    margin: 0 0 6px 0;
    padding-bottom: 4px;
    border-bottom: 1px solid #e2e8f0;
  }

  .po-professional .info-panel p {
    margin: 2px 0;
  }

  .po-professional .info-label {
    font-weight: 600;
    display: inline-block;
    width: 55px;
    color: #475569;
  }

  .po-professional .line-items-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 18px;
    font-size: 8pt;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    overflow: hidden;
  }

  .po-professional .line-items-table th {
    background: #2563eb;
    color: #fff;
    padding: 7px 10px;
    text-align: left;
    font-weight: 600;
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .po-professional .line-items-table th:nth-child(1) { width: 8%; text-align: center; }
  .po-professional .line-items-table th:nth-child(2) { width: 42%; }
  .po-professional .line-items-table th:nth-child(3) { width: 12%; }
  .po-professional .line-items-table th:nth-child(4) { width: 12%; text-align: right; }
  .po-professional .line-items-table th:nth-child(5) { width: 8%; text-align: center; }
  .po-professional .line-items-table th:nth-child(6) { width: 18%; text-align: right; }

  .po-professional .line-items-table td {
    padding: 6px 10px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: top;
  }

  .po-professional .line-items-table td:nth-child(1) { text-align: center; }
  .po-professional .line-items-table td:nth-child(4) { text-align: right; }
  .po-professional .line-items-table td:nth-child(5) { text-align: center; }
  .po-professional .line-items-table td:nth-child(6) { text-align: right; font-weight: 600; }

  .po-professional .line-items-table tr:nth-child(even) {
    background: #f8fafc;
  }

  .po-professional .totals-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .po-professional .notes-box {
    flex: 1;
    margin-right: 24px;
  }

  .po-professional .notes-box h4 {
    font-weight: 600;
    font-size: 9pt;
    color: #2563eb;
    margin: 0 0 4px 0;
  }

  .po-professional .totals-box {
    width: 220px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 10px 12px;
  }

  .po-professional .totals-box table { width: 100%; }

  .po-professional .totals-box td {
    padding: 3px 0;
  }

  .po-professional .totals-box td:first-child {
    text-align: right;
    padding-right: 10px;
    color: #475569;
  }

  .po-professional .totals-box td:last-child {
    text-align: right;
    font-weight: 600;
  }

  .po-professional .totals-box .total-row {
    border-top: 2px solid #2563eb;
    font-size: 10pt;
  }

  .po-professional .totals-box .total-row td {
    padding-top: 6px;
    color: #2563eb;
    font-weight: 700;
  }

  .po-professional .colour-section {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 16px;
    font-size: 8pt;
  }

  .po-professional .colour-section h4 {
    font-weight: 600;
    margin: 0 0 6px 0;
    color: #92400e;
    font-size: 8pt;
  }

  .po-professional .colour-list { margin: 0; padding-left: 0; list-style: none; }
  .po-professional .colour-list li { padding: 2px 0; }

  .po-professional .remittance-section {
    font-size: 8pt;
    margin-bottom: 16px;
    border-top: 2px solid #e2e8f0;
    padding-top: 10px;
  }

  .po-professional .remittance-section h4 {
    font-weight: 600;
    margin: 0 0 5px 0;
    color: #2563eb;
    font-size: 8pt;
  }

  .po-professional .conditions-section {
    font-size: 7pt;
    background: #f8fafc;
    padding: 10px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #64748b;
  }

  .po-professional .conditions-section h4 {
    font-weight: 600;
    margin: 0 0 5px 0;
    font-size: 8pt;
    color: #475569;
  }

  .po-professional .conditions-section ol { margin: 0; padding-left: 15px; }
  .po-professional .conditions-section li { margin-bottom: 3px; }

  .po-professional .delivery-note {
    font-style: italic;
    color: #94a3b8;
    font-size: 7pt;
  }
</style>

<div class="po-professional">
  <div class="po-header">
    <span class="po-title">Purchase Order</span>
    <div class="po-meta-box">
      <div class="po-number"><%= purchase_order[:purchase_order_number] %></div>
      <% if purchase_order[:required_date].present? %>
        <div class="po-date">Delivery: <%= purchase_order[:required_date] %></div>
      <% end %>
    </div>
  </div>

  <div class="info-grid">
    <div class="info-panel">
      <h4>Delivery Address</h4>
      <p><%= purchase_order[:delivery_address] || job[:full_address] %></p>
      <% if job[:suburb].present? %>
        <p><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p>
      <% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %>
        <p class="delivery-note">Lot <%= job[:lot_number] %> Plan <%= job[:plan_number] %></p>
      <% end %>
    </div>

    <div class="info-panel">
      <h4>Supplier</h4>
      <p><strong><%= purchase_order[:supplier][:name] %></strong></p>
      <% if purchase_order[:supplier][:phone].present? %><p><%= purchase_order[:supplier][:phone] %></p><% end %>
      <% if purchase_order[:supplier][:email].present? %><p><%= purchase_order[:supplier][:email] %></p><% end %>
    </div>

    <div class="info-panel">
      <h4>Site Contact</h4>
      <p class="delivery-note">Ring Supervisor 3 days prior to delivery</p>
      <% if purchase_order[:site_supervisor][:name].present? %>
        <p><span class="info-label">Sup:</span> <%= purchase_order[:site_supervisor][:name] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:email].present? %>
        <p><span class="info-label">Email:</span> <%= purchase_order[:site_supervisor][:email] %></p>
      <% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %>
        <p><span class="info-label">Phone:</span> <%= purchase_order[:site_supervisor][:phone] %></p>
      <% end %>
    </div>
  </div>

  <table class="line-items-table">
    <thead>
      <tr>
        <th>Qty</th>
        <th>Description</th>
        <th>Code</th>
        <th>Rate</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each do |item| %>
        <tr>
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td><%= item[:pricebook_code] %></td>
          <td><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="totals-row">
    <div class="notes-box">
      <% if purchase_order[:special_instructions].present? %>
        <h4>Notes</h4>
        <p><%= purchase_order[:special_instructions] %></p>
      <% end %>
    </div>

    <div class="totals-box">
      <table>
        <tr><td>Sub Total:</td><td><%= purchase_order[:subtotal] %></td></tr>
        <tr><td>GST:</td><td><%= purchase_order[:gst] %></td></tr>
        <tr class="total-row"><td>Total:</td><td><%= purchase_order[:total] %></td></tr>
      </table>
    </div>
  </div>

  <% if defined?(colour_selections) && colour_selections[:has_selections] %>
    <div class="colour-section">
      <h4>Colour Selections</h4>
      <ul class="colour-list">
        <% colour_selections[:flat_list].each do |selection| %>
          <li><strong><%= selection[:item].to_s.titleize %>:</strong> <%= selection[:colour] %><%= " (#{selection[:brand]})" if selection[:brand].present? %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="remittance-section">
    <h4>Remittance Details</h4>
    <p>
      <strong>Invoices to:</strong> <%= company[:company_name] %><br>
      <strong>Email:</strong> <%= company[:email] %> &nbsp;
      <strong>Phone:</strong> <%= company[:phone_formatted] %> &nbsp;
      <strong>Address:</strong> <%= company[:full_address] %>
    </p>
    <p><strong>Payment schedule:</strong></p>
    <ul style="margin: 5px 0; padding-left: 20px; font-size: 7pt;">
      <li><strong>7-day accounts:</strong> Invoices received before COB Wednesday will be paid the following Thursday.</li>
      <li><strong>14-day accounts:</strong> Invoices received before COB Wednesday will be paid on the Thursday two weeks later.</li>
      <li><strong>30-day accounts:</strong> Invoices received before COB on the last day of the month will be paid on the last day of the following month.</li>
    </ul>
    <p style="font-size: 7pt;">
      The correct purchase order number and job address MUST be included on your tax invoice.<br>
      Tax invoices without these details will be returned to the supplier for correction.
    </p>
  </div>

  <div class="conditions-section">
    <h4>Conditions of Acceptance</h4>
    <ol>
      <% (company[:po_conditions] || []).each do |condition| %>
        <li><%= condition %></li>
      <% end %>
    </ol>
  </div>
</div>
