<h1>Deposit Claim Invoice</h1>

<div style="display: flex; justify-content: space-between; margin-bottom: var(--space-6);">
  <div>
    <p style="margin: 0; color: var(--color-text-secondary);">Invoice Date</p>
    <p style="margin: 0; font-weight: bold;"><%= format_date(today, :long) %></p>
  </div>
  <div style="text-align: right;">
    <p style="margin: 0; color: var(--color-text-secondary);">Due Date</p>
    <p style="margin: 0; font-weight: bold;"><%= format_date(today + 14.days, :long) %></p>
  </div>
</div>

<div style="background-color: var(--color-muted); padding: var(--space-4); border-radius: 4px; margin-bottom: var(--space-6);">
  <p style="margin: 0 0 var(--space-2) 0; color: var(--color-text-secondary);">Property</p>
  <p style="margin: 0; font-weight: bold; font-size: 1.1em;"><%= @job[:full_address] %></p>
  <% if @job[:job_number].present? %>
    <p style="margin: var(--space-2) 0 0 0; color: var(--color-text-secondary);">Job #<%= @job[:job_number] %></p>
  <% end %>
</div>

<h2>Bill To</h2>
<div style="margin-bottom: var(--space-6);">
  <% @clients&.each do |client| %>
    <p style="margin: 0;">
      <strong><%= client[:name] %></strong>
      <% if client[:email].present? %>
        <br><span style="color: var(--color-text-secondary);"><%= client[:email] %></span>
      <% end %>
    </p>
  <% end %>
</div>

<table style="width: 100%; border-collapse: collapse; margin-bottom: var(--space-6);">
  <thead>
    <tr style="border-bottom: 2px solid var(--color-border);">
      <th style="text-align: left; padding: var(--space-2);">Description</th>
      <th style="text-align: right; padding: var(--space-2);">Amount</th>
    </tr>
  </thead>
  <tbody>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="padding: var(--space-3) var(--space-2);">
        <strong>Deposit - Contract Signing</strong>
        <br><span style="color: var(--color-text-secondary);">5% of contract value as per QBCC requirements</span>
      </td>
      <td style="text-align: right; padding: var(--space-3) var(--space-2);">
        <% deposit_amount = (@job[:contract_value_raw] || 0) * 0.05 %>
        <%= format_currency(deposit_amount) %>
      </td>
    </tr>
  </tbody>
  <tfoot>
    <tr style="border-top: 2px solid var(--color-border);">
      <td style="padding: var(--space-2); text-align: right;"><strong>Subtotal</strong></td>
      <td style="padding: var(--space-2); text-align: right;"><%= format_currency(deposit_amount) %></td>
    </tr>
    <tr>
      <td style="padding: var(--space-2); text-align: right;"><strong>GST (10%)</strong></td>
      <td style="padding: var(--space-2); text-align: right;"><%= format_currency(deposit_amount * 0.1) %></td>
    </tr>
    <tr style="background-color: var(--color-muted);">
      <td style="padding: var(--space-3); text-align: right; font-size: 1.2em;"><strong>Total Due</strong></td>
      <td style="padding: var(--space-3); text-align: right; font-size: 1.2em;"><strong><%= format_currency(deposit_amount * 1.1) %></strong></td>
    </tr>
  </tfoot>
</table>

<div style="background-color: #f0f7ff; padding: var(--space-4); border-radius: 4px; margin-bottom: var(--space-6);">
  <h3 style="margin: 0 0 var(--space-2) 0;">Payment Details</h3>
  <p style="margin: 0; font-size: 0.9em;">
    Bank: <%= @company[:bank_name] || "Commonwealth Bank" %><br>
    Account Name: <%= @company[:name] %><br>
    BSB: <%= @company[:bsb] || "064-XXX" %><br>
    Account: <%= @company[:account_number] || "XXXXXXXX" %><br>
    Reference: <%= @job[:job_number] || @job[:id] %> - Deposit
  </p>
</div>

<div style="color: var(--color-text-secondary); font-size: 0.85em;">
  <p>
    <strong>Terms:</strong> Payment due within 14 days of invoice date.
    This deposit is required prior to contract signing as per QBCC building contract requirements.
  </p>
  <p>
    <strong>Note:</strong> The deposit represents 5% of the contract value and will be credited
    against the final contract price. Progress payments will be claimed as per the payment schedule
    in your building contract.
  </p>
</div>
