<div style="text-align: center; margin-bottom: 24px;">
  <img src="https://www.qbcc.qld.gov.au/sites/default/files/QBCC_logo.png" alt="QBCC" style="height: 60px; margin-bottom: 12px;">
  <h1 style="font-size: 18px; font-weight: bold; margin: 0;">QBCC BUILDING CONTRACT</h1>
  <p style="font-size: 12px; margin: 8px 0 0 0;">For Detached Dwellings and Associated Work</p>
</div>

<table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
  <tr>
    <td style="width: 25%; background: #f0f0f0; padding: 6px; border: 1px solid #000; font-weight: bold;">Contract Date:</td>
    <td style="padding: 6px; border: 1px solid #000;"><%= @job[:contract_date] %></td>
    <td style="width: 25%; background: #f0f0f0; padding: 6px; border: 1px solid #000; font-weight: bold;">Job Number:</td>
    <td style="padding: 6px; border: 1px solid #000;"><%= @job[:job_number] %></td>
  </tr>
</table>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART A - PARTIES TO THE CONTRACT</h2>

<h3 style="font-size: 12px; font-weight: bold; margin: 12px 0 8px 0;">THE OWNER (Building Owner)</h3>

<table style="width: 100%; border-collapse: collapse;">
  <% if @client_1.present? %>
  <tr>
    <td style="width: 20%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Name:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @client_1[:full_name] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Address:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @client_1[:full_address] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Phone:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @client_1[:phone] %></td>
    <td style="width: 15%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Email:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @client_1[:email] %></td>
  </tr>
  <% end %>
</table>

<% if @client_2.present? %>
<h4 style="font-size: 11px; font-weight: bold; margin: 12px 0 4px 0;">Second Owner (if applicable)</h4>
<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="width: 20%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Name:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @client_2[:full_name] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Address:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @client_2[:full_address] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Phone:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @client_2[:phone] %></td>
    <td style="width: 15%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Email:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @client_2[:email] %></td>
  </tr>
</table>
<% end %>

<h3 style="font-size: 12px; font-weight: bold; margin: 16px 0 8px 0;">THE CONTRACTOR (Building Contractor)</h3>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="width: 20%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Name:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @company[:name] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">ABN:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @company[:abn_formatted] %></td>
    <td style="width: 20%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">QBCC Licence:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @company[:qbcc_license] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Address:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @company[:full_address] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Phone:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @company[:phone_formatted] %></td>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Email:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @company[:email] %></td>
  </tr>
</table>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART B - THE SITE</h2>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="width: 20%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Site Address:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @job[:full_address] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Lot Number:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @job[:lot_number] %></td>
    <td style="width: 20%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Plan Number:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @job[:plan_number] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Council:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @job[:council] %></td>
  </tr>
</table>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART C - THE BUILDING WORK</h2>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="width: 25%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Description of Work:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;" colspan="3"><%= @job[:description] || "Construction of new dwelling" %></td>
  </tr>
</table>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART D - CONTRACT PRICE AND PAYMENT</h2>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="width: 40%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Contract Price (including GST):</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; font-weight: bold;"><%= @job[:contract_price] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Deposit (max 5% of contract price):</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @job[:deposit_amount] %></td>
  </tr>
</table>

<h3 style="font-size: 11px; font-weight: bold; margin: 12px 0 8px 0;">Progress Payment Schedule</h3>

<table style="width: 100%; border-collapse: collapse;">
  <tr style="background: #f0f0f0;">
    <th style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: left;">Stage</th>
    <th style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right; width: 15%;">Percentage</th>
    <th style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right; width: 20%;">Amount</th>
  </tr>
  <tr>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Deposit</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">5%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"></td>
  </tr>
  <tr>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Base Stage</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">15%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"></td>
  </tr>
  <tr>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Frame Stage</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">20%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"></td>
  </tr>
  <tr>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Enclosed Stage</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">20%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"></td>
  </tr>
  <tr>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Fixing Stage</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">20%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"></td>
  </tr>
  <tr>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Practical Completion</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">20%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"></td>
  </tr>
  <tr style="background: #f0f0f0; font-weight: bold;">
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;">TOTAL</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;">100%</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px; text-align: right;"><%= @job[:contract_price] %></td>
  </tr>
</table>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART E - CONTRACT PERIOD</h2>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="width: 40%; background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Building Period (working days):</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @job[:build_period] %></td>
  </tr>
  <tr>
    <td style="background: #f0f0f0; padding: 4px 6px; border: 1px solid #000; font-size: 10px;">Expected Site Start:</td>
    <td style="padding: 4px 6px; border: 1px solid #000; font-size: 10px;"><%= @job[:expected_start_date] %></td>
  </tr>
</table>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART F - CONTRACT DOCUMENTS</h2>

<p style="font-size: 10px; margin: 8px 0;">
  The following documents form part of this contract:
</p>

<ol style="font-size: 10px; margin: 0 0 0 20px; padding: 0;">
  <li>This Contract (QBCC Building Contract)</li>
  <li>QBCC General Conditions of Contract</li>
  <li>Plans and Specifications</li>
  <li>Colour Selections</li>
  <li>Any special conditions attached</li>
</ol>

<div style="background: #fff3cd; border: 2px solid #ffc107; padding: 12px; margin: 16px 0; font-size: 10px;">
  <strong>COOLING-OFF PERIOD</strong><br>
  You have a 5 business day cooling-off period after signing this contract during which you may
  terminate the contract without penalty (except for reasonable costs already incurred by the contractor).
  To terminate, you must give written notice to the contractor.
</div>

<h2 style="font-size: 14px; background: #000; color: #fff; padding: 6px 8px; margin: 16px 0 8px 0;">PART G - SIGNATURES</h2>

<p style="font-size: 10px; margin: 8px 0;">
  By signing below, the parties agree to be bound by the terms and conditions of this contract.
</p>

<table style="width: 100%; border-collapse: collapse; margin-top: 24px;">
  <tr>
    <td style="width: 48%; vertical-align: top; padding-right: 12px;">
      <p style="font-size: 10px; font-weight: bold; margin: 0 0 4px 0;">THE OWNER</p>
      <div style="border-bottom: 1px solid #000; height: 40px; margin-bottom: 4px;"></div>
      <p style="font-size: 9px; margin: 0;">Signature: Owner 1</p>
      <div style="border-bottom: 1px solid #000; height: 20px; margin: 16px 0 4px 0;"></div>
      <p style="font-size: 9px; margin: 0;">Print Name</p>
      <div style="border-bottom: 1px solid #000; height: 20px; margin: 16px 0 4px 0;"></div>
      <p style="font-size: 9px; margin: 0;">Date</p>

      <% if @client_2.present? %>
      <div style="margin-top: 24px;">
        <div style="border-bottom: 1px solid #000; height: 40px; margin-bottom: 4px;"></div>
        <p style="font-size: 9px; margin: 0;">Signature: Owner 2</p>
        <div style="border-bottom: 1px solid #000; height: 20px; margin: 16px 0 4px 0;"></div>
        <p style="font-size: 9px; margin: 0;">Print Name</p>
        <div style="border-bottom: 1px solid #000; height: 20px; margin: 16px 0 4px 0;"></div>
        <p style="font-size: 9px; margin: 0;">Date</p>
      </div>
      <% end %>
    </td>
    <td style="width: 4%;"></td>
    <td style="width: 48%; vertical-align: top; padding-left: 12px;">
      <p style="font-size: 10px; font-weight: bold; margin: 0 0 4px 0;">THE CONTRACTOR</p>
      <div style="border-bottom: 1px solid #000; height: 40px; margin-bottom: 4px;"></div>
      <p style="font-size: 9px; margin: 0;">Signature</p>
      <div style="border-bottom: 1px solid #000; height: 20px; margin: 16px 0 4px 0;"></div>
      <p style="font-size: 9px; margin: 0;">Print Name</p>
      <div style="border-bottom: 1px solid #000; height: 20px; margin: 16px 0 4px 0;"></div>
      <p style="font-size: 9px; margin: 0;">Date</p>
      <p style="font-size: 9px; margin: 16px 0 0 0;">
        For and on behalf of<br>
        <strong><%= @company[:name] %></strong><br>
        QBCC Licence: <%= @company[:qbcc_license] %>
      </p>
    </td>
  </tr>
</table>

<div style="border-top: 2px solid #000; margin-top: 32px; padding-top: 8px; font-size: 9px; text-align: center; color: #666;">
  QBCC Building Contract for Detached Dwellings | Queensland Building and Construction Commission | www.qbcc.qld.gov.au
</div>
