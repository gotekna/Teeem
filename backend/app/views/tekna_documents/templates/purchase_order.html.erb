<% # Purchase Order Template Router — picks variant from TenantSetting %>
<% # Available variants: classic, modern, bold, compact, professional, construction %>
<% # Each variant is a partial in templates/purchase_order/_variant.html.erb %>
<% # All variants receive identical data context (purchase_order, job, company, colour_selections) %>

<% variant = defined?(po_template_variant) ? po_template_variant : "classic" %>
<% valid_variants = %w[classic modern bold compact professional construction] %>
<% variant = "classic" unless valid_variants.include?(variant) %>

<%= render "templates/purchase_order/#{variant}" %>
