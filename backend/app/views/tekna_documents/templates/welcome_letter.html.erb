<h1>Welcome to Tekna Homes</h1>

<p style="color: var(--color-text-secondary);"><%= format_date(today, :long) %></p>

<p><%= @dear %></p>

<p>
  Congratulations on choosing <%= @company[:name] %> to build your new home at
  <strong><%= @job[:full_address] %></strong>.
</p>

<p>
  We are delighted to welcome you to the <%= @company[:name] %> family and look forward
  to working with you throughout the construction of your new home.
</p>

<h2>Your Build Team</h2>

<table>
  <tr>
    <td style="width: 40%; background: #f5f5f5;"><strong>Site Supervisor</strong></td>
    <td><%= @job[:site_supervisor_name] || "To be assigned" %></td>
  </tr>
  <tr>
    <td style="background: #f5f5f5;"><strong>Contact Phone</strong></td>
    <td><%= @job[:site_supervisor_phone] || @company[:phone_formatted] %></td>
  </tr>
  <tr>
    <td style="background: #f5f5f5;"><strong>Office Email</strong></td>
    <td><%= @company[:email] %></td>
  </tr>
  <tr>
    <td style="background: #f5f5f5;"><strong>Office Phone</strong></td>
    <td><%= @company[:phone_formatted] %></td>
  </tr>
</table>

<h2>Project Details</h2>

<table>
  <tr>
    <td style="width: 40%; background: #f5f5f5;"><strong>Job Number</strong></td>
    <td><%= @job[:job_number] %></td>
  </tr>
  <tr>
    <td style="background: #f5f5f5;"><strong>Site Address</strong></td>
    <td><%= @job[:full_address] %></td>
  </tr>
  <% if @job[:lot_number].present? %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Lot/Plan</strong></td>
    <td>Lot <%= @job[:lot_number] %> on Plan <%= @job[:plan_number] %></td>
  </tr>
  <% end %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Contract Price</strong></td>
    <td><%= @job[:contract_price] %> (inc. GST)</td>
  </tr>
  <tr>
    <td style="background: #f5f5f5;"><strong>Contract Date</strong></td>
    <td><%= @job[:contract_date] %></td>
  </tr>
  <% if @job[:build_period].present? %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Build Period</strong></td>
    <td><%= @job[:build_period] %></td>
  </tr>
  <% end %>
</table>

<h2>What Happens Next?</h2>

<ol>
  <li>Your site supervisor will contact you to arrange an initial site meeting</li>
  <li>We will submit your plans to council for approval (if not already approved)</li>
  <li>Once approved, we will schedule your site start date</li>
  <li>You will receive regular progress updates throughout your build</li>
</ol>

<p>
  If you have any questions at any time, please don't hesitate to contact our office
  on <strong><%= @company[:phone_formatted] %></strong> or email
  <strong><%= @company[:email] %></strong>.
</p>

<p>
  We look forward to building your dream home.
</p>

<p style="margin-top: var(--space-8);">
  Kind regards,<br><br>
  <strong>The <%= @company[:name] %> Team</strong>
</p>
