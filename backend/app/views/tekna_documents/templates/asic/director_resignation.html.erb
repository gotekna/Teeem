<% # Director Resignation Letter - ASIC Form 484 Package %>
<% # Template variables: company, director, positions, cessation_date, cessation_date_formatted %>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 18pt; margin-bottom: 5px;">LETTER OF RESIGNATION</h1>
    <p class="small-text">Corporations Act 2001</p>
  </div>

  <div class="section">
    <p style="margin-bottom: 15px;"><strong>Date:</strong> <%= cessation_date_formatted %></p>

    <p style="margin-bottom: 15px;">
      The Directors<br>
      <strong><%= company[:name] %></strong><br>
      <% if company[:acn].present? %>ACN: <%= company[:formatted_acn] %><br><% end %>
      <% if company[:registered_office_address].present? %>
        <%= company[:registered_office_address] %>
      <% end %>
    </p>
  </div>

  <div class="section">
    <p style="margin-bottom: 15px;">Dear Directors,</p>

    <p style="margin-bottom: 15px;">
      I, <strong><%= director[:full_name] %></strong>, hereby tender my resignation from the following
      position<%= positions.length > 1 ? "s" : "" %> with <strong><%= company[:name] %></strong>
      (<% if company[:acn].present? %>ACN <%= company[:formatted_acn] %><% end %>):
    </p>

    <ul style="margin: 15px 0 15px 30px;">
      <% positions.each do |position| %>
        <li style="margin-bottom: 5px;"><%= position.titleize.gsub("_", " / ") %></li>
      <% end %>
    </ul>

    <p style="margin-bottom: 15px;">
      This resignation is effective from <strong><%= cessation_date_formatted %></strong>.
    </p>

    <p style="margin-bottom: 15px;">
      I confirm that I have no outstanding claims against the company and that all company
      property, documents, and records in my possession have been or will be returned.
    </p>

    <p style="margin-bottom: 30px;">
      Yours faithfully,
    </p>
  </div>

  <!-- Signature Block -->
  <div style="margin-top: 40px;">
    <table style="width: 100%; border: none;">
      <tr>
        <td style="width: 50%; border: none; padding: 0;">
          <div class="field-label">Signature:</div>
          <div class="signature-box" style="margin-top: 5px;"></div>
        </td>
        <td style="width: 50%; border: none; padding: 0;">
          <div class="field-label">Date:</div>
          <div style="border-bottom: 1px solid #000; min-width: 200px; min-height: 30px; margin-top: 5px; padding: 5px;">
            <%= cessation_date_formatted %>
          </div>
        </td>
      </tr>
    </table>

    <div style="margin-top: 20px;">
      <div class="field-label">Full Name:</div>
      <div class="field-value"><%= director[:full_name] %></div>
    </div>

    <% if director[:date_of_birth].present? %>
      <div style="margin-top: 10px;">
        <div class="field-label">Date of Birth:</div>
        <div class="field-value"><%= director[:date_of_birth] %></div>
      </div>
    <% end %>

    <% if director[:address].present? %>
      <div style="margin-top: 10px;">
        <div class="field-label">Residential Address:</div>
        <div class="field-value"><%= director[:address] %></div>
      </div>
    <% end %>
  </div>
</div>
