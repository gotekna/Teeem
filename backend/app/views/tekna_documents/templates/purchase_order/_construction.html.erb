<% # Site Order — Construction-focused. Prominent delivery & supervisor. Professional slate tone. %>
<style>
  .po-construction {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    font-size: 9pt;
    line-height: 1.5;
    color: #1f2937;
  }

  .po-construction p { margin: 2px 0; }

  /* ── Header ── */
  .po-construction .pct-hdr {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 14px;
    border-bottom: 3px solid #334155;
    margin-bottom: 16px;
  }

  .po-construction .pct-hdr-l { display: flex; gap: 12px; align-items: flex-start; }

  .po-construction .pct-logo-box {
    width: 44px;
    height: 44px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18pt;
    font-weight: 700;
    color: #334155;
    flex-shrink: 0;
    overflow: hidden;
  }

  .po-construction .pct-logo-box img { width: 100%; height: 100%; object-fit: contain; }

  .po-construction .pct-co-name { font-size: 11pt; font-weight: 700; color: #111827; margin-bottom: 3px; }
  .po-construction .pct-co-detail { font-size: 7.5pt; color: #9ca3af; }

  .po-construction .pct-hdr-r { text-align: right; }
  .po-construction .pct-doc-label { font-size: 9pt; font-weight: 400; color: #9ca3af; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 3px; }
  .po-construction .pct-num { font-size: 14pt; font-weight: 700; color: #111827; }
  .po-construction .pct-date { font-size: 7.5pt; color: #9ca3af; margin-top: 4px; }
  .po-construction .pct-required {
    display: inline-block;
    background: #334155;
    color: #fff;
    font-size: 7.5pt;
    font-weight: 600;
    padding: 2px 8px;
    margin-top: 4px;
  }

  /* ── Delivery hero — prominent for construction ── */
  .po-construction .pct-delivery {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #334155;
    padding: 12px 16px;
    margin-bottom: 14px;
    display: flex;
    gap: 24px;
  }

  .po-construction .pct-delivery-addr { flex: 2; }
  .po-construction .pct-delivery-sup { flex: 1; border-left: 1px solid #e2e8f0; padding-left: 20px; }

  .po-construction .pct-delivery-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #334155;
    margin-bottom: 5px;
  }

  .po-construction .pct-delivery-addr-text {
    font-size: 10.5pt;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .po-construction .pct-sup-name { font-size: 10.5pt; font-weight: 700; color: #111827; margin-bottom: 2px; }
  .po-construction .pct-delivery-dim { color: #9ca3af; font-size: 7.5pt; font-style: italic; margin-top: 3px; }

  /* ── Supplier strip ── */
  .po-construction .pct-supplier {
    display: flex;
    gap: 0;
    margin-bottom: 16px;
    border: 1px solid #e2e8f0;
  }

  .po-construction .pct-supplier-col {
    flex: 1;
    padding: 8px 12px;
    border-right: 1px solid #e2e8f0;
    font-size: 8pt;
  }

  .po-construction .pct-supplier-col:last-child { border-right: none; }

  .po-construction .pct-sup-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: #6b7280;
    margin-bottom: 4px;
  }

  /* ── Table ── */
  .po-construction .pct-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 18px;
    font-size: 8.5pt;
  }

  .po-construction .pct-tbl th {
    background: #334155;
    color: #fff;
    padding: 7px 10px;
    font-size: 7pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    text-align: left;
  }

  .po-construction .pct-tbl th:nth-child(1) { width: 40px; text-align: center; }
  .po-construction .pct-tbl th:nth-child(4) { width: 80px; text-align: right; }
  .po-construction .pct-tbl th:nth-child(5) { width: 36px; text-align: center; }
  .po-construction .pct-tbl th:nth-child(6) { width: 90px; text-align: right; }

  .po-construction .pct-tbl td {
    padding: 7px 10px;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: top;
    color: #374151;
  }

  .po-construction .pct-tbl td:nth-child(1) { text-align: center; color: #9ca3af; }
  .po-construction .pct-tbl td:nth-child(4) { text-align: right; }
  .po-construction .pct-tbl td:nth-child(5) { text-align: center; color: #9ca3af; }
  .po-construction .pct-tbl td:nth-child(6) { text-align: right; font-weight: 700; color: #111827; }

  .po-construction .pct-alt td { background: #f8fafc; }

  /* ── Bottom: Notes + Totals ── */
  .po-construction .pct-bottom {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
    align-items: flex-start;
  }

  .po-construction .pct-notes { flex: 1; }

  .po-construction .pct-sec-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #6b7280;
    margin-bottom: 5px;
  }

  .po-construction .pct-notes-body { font-size: 8pt; color: #4b5563; line-height: 1.5; }

  .po-construction .pct-colour-tag {
    display: inline-block;
    font-size: 7pt;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    padding: 1px 6px;
    margin: 2px 2px 2px 0;
    color: #334155;
  }

  .po-construction .pct-totals { width: 200px; flex-shrink: 0; }

  .po-construction .pct-tot-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 8pt;
    color: #6b7280;
    border-bottom: 1px solid #f0f0f0;
  }

  .po-construction .pct-tot-final {
    display: flex;
    justify-content: space-between;
    padding: 8px 0 4px;
    font-size: 11pt;
    font-weight: 700;
    color: #334155;
    border-top: 2px solid #334155;
    margin-top: 2px;
  }

  /* ── Footer ── */
  .po-construction .pct-remit {
    font-size: 7.5pt;
    color: #6b7280;
    padding: 8px 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    margin-bottom: 10px;
  }

  .po-construction .pct-warn {
    font-size: 6.5pt;
    color: #b91c1c;
    font-weight: 600;
    padding: 5px 10px;
    background: #fff8f8;
    border-left: 3px solid #dc2626;
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .po-construction .pct-cond {
    font-size: 6.5pt;
    color: #9ca3af;
    border-top: 1px solid #e2e8f0;
    padding-top: 8px;
  }

  .po-construction .pct-cond ol { margin: 4px 0 0; padding-left: 14px; }
  .po-construction .pct-cond li { margin-bottom: 2px; }
</style>

<div class="po-construction">

  <!-- Header: company left | PO + number right -->
  <div class="pct-hdr">
    <div class="pct-hdr-l">
      <div class="pct-logo-box">
        <% if company[:logo_url].present? %>
          <img src="<%= company[:logo_url] %>" alt="<%= company[:company_name] %>">
        <% else %>
          <%= company[:company_name].to_s.first.upcase %>
        <% end %>
      </div>
      <div>
        <div class="pct-co-name"><%= company[:company_name] %></div>
        <div class="pct-co-detail">ABN <%= company[:abn_formatted] %><% if company[:qbcc_license].present? %> · QBCC <%= company[:qbcc_license] %><% end %></div>
        <div class="pct-co-detail"><%= company[:phone_formatted] %><% if company[:email].present? %> · <%= company[:email] %><% end %></div>
      </div>
    </div>
    <div class="pct-hdr-r">
      <div class="pct-doc-label">Purchase Order</div>
      <div class="pct-num"><%= purchase_order[:purchase_order_number] %></div>
      <% if purchase_order[:ted_task].present? %><div class="pct-date"><%= purchase_order[:ted_task] %></div><% end %>
      <% if purchase_order[:required_date].present? %>
        <div class="pct-required">Required on site: <%= purchase_order[:required_date] %></div>
      <% end %>
    </div>
  </div>

  <!-- Delivery hero: site address + supervisor side by side -->
  <div class="pct-delivery">
    <div class="pct-delivery-addr">
      <div class="pct-delivery-label">Site Delivery Address</div>
      <div class="pct-delivery-addr-text"><%= purchase_order[:delivery_address] || job[:full_address] %></div>
      <% if job[:suburb].present? %>
        <p style="font-size:10.5pt;font-weight:600;color:#374151"><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p>
      <% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %>
        <p class="pct-delivery-dim">Lot <%= job[:lot_number] %> · Plan <%= job[:plan_number] %></p>
      <% end %>
    </div>
    <div class="pct-delivery-sup">
      <div class="pct-delivery-label">Site Supervisor</div>
      <% if purchase_order[:site_supervisor][:name].present? %><div class="pct-sup-name"><%= purchase_order[:site_supervisor][:name] %></div><% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %><p><%= purchase_order[:site_supervisor][:phone] %></p><% end %>
      <% if purchase_order[:site_supervisor][:email].present? %><p style="font-size:7.5pt;color:#6b7280"><%= purchase_order[:site_supervisor][:email] %></p><% end %>
      <p class="pct-delivery-dim">Ring 3 days prior to delivery</p>
    </div>
  </div>

  <!-- Supplier strip -->
  <div class="pct-supplier">
    <div class="pct-supplier-col">
      <div class="pct-sup-label">Supplier</div>
      <p style="font-weight:600;color:#111827"><%= purchase_order[:supplier][:name] %></p>
      <% if purchase_order[:supplier][:phone].present? %><p><%= purchase_order[:supplier][:phone] %></p><% end %>
    </div>
    <div class="pct-supplier-col">
      <div class="pct-sup-label">Supplier Contact</div>
      <% if purchase_order[:supplier][:email].present? %><p><%= purchase_order[:supplier][:email] %></p><% end %>
    </div>
  </div>

  <!-- Line Items -->
  <table class="pct-tbl">
    <thead>
      <tr>
        <th>QTY</th>
        <th>Description</th>
        <th>Code</th>
        <th>Rate</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each_with_index do |item, index| %>
        <tr class="<%= index.odd? ? 'pct-alt' : '' %>">
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace;font-size:7.5pt;color:#9ca3af"><%= item[:pricebook_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Notes + Colours + Totals -->
  <div class="pct-bottom">
    <div class="pct-notes">
      <div class="pct-sec-label">Notes</div>
      <div class="pct-notes-body">
        <% if purchase_order[:special_instructions].present? %>
          <%= purchase_order[:special_instructions] %>
        <% else %>
          <span style="color:#d1d5db;font-style:italic">No special instructions</span>
        <% end %>
      </div>

      <% if defined?(colour_selections) && colour_selections[:has_selections] %>
        <% filled = colour_selections[:flat_list].select { |s| s[:colour].present? } %>
        <% if filled.any? %>
          <div class="pct-sec-label" style="margin-top:10px">Colour Selections</div>
          <div>
            <% filled.each do |s| %>
              <span class="pct-colour-tag"><strong><%= s[:item].to_s.titleize %></strong>: <%= s[:colour] %><% if s[:brand].present? %> (<%= s[:brand] %>)<% end %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="pct-totals">
      <div class="pct-tot-row"><span>Sub Total</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:subtotal] %></span></div>
      <div class="pct-tot-row"><span>GST</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:gst] %></span></div>
      <div class="pct-tot-final"><span>Total (incl GST)</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:total] %></span></div>
    </div>
  </div>

  <!-- Remittance -->
  <div class="pct-remit">
    <div class="pct-sec-label">Remittance</div>
    Invoices to <strong><%= company[:company_name] %></strong> — <%= company[:email] %>
    <% payment_days = purchase_order[:supplier][:payment_terms_days] %>
    <% if payment_days.present? && payment_days.to_i <= 14 %>
      <div style="margin-top:2px">
        <% if payment_days.to_i <= 7 %>
          <strong>7-day account:</strong> Invoices received before COB Wednesday paid the following Thursday.
        <% else %>
          <strong>14-day account:</strong> Invoices received before COB Wednesday paid Thursday two weeks later.
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Warning -->
  <div class="pct-warn">
    The correct purchase order number and job address MUST be included on your tax invoice. Tax invoices without these details will be returned to the supplier for correction. Tax invoices exceeding the order total may delay payment.
  </div>

  <!-- Conditions -->
  <div class="pct-cond">
    <div style="font-size:6.5pt;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#9ca3af;margin-bottom:4px">Conditions of Acceptance</div>
    <ol>
      <li>If the purchase order is incorrect, please contact our office immediately.</li>
      <li>If additional work/items are required, then a NEW order number must be received.</li>
      <li>The correct purchase order number and job address MUST be included on your tax invoice. Tax invoices without these details will be returned to the supplier for correction.</li>
      <li>Processing of order will acknowledge acceptance of these conditions.</li>
      <li>In the instance the work is not completed by the original supplier in the specified timeframe, '<%= company[:company_name] %>' reserves the right to engage another supplier to complete the work. The new supplier will be paid from the original purchase order amount and any balance of funds will then be paid to the original supplier.</li>
      <li>Please ensure invoice is made out to <%= company[:company_name] %>.</li>
      <li>This purchase order is issued pursuant to the terms of the subcontract agreement. By accepting this purchase order you confirm that you agree to these subcontract terms.</li>
    </ol>
  </div>

</div>
