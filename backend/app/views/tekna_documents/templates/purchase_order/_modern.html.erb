<% # Modern Minimal — Xero-style. Pure whitespace, hairline dividers, no backgrounds. %>
<style>
  .po-modern {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    font-size: 9pt;
    line-height: 1.5;
    color: #374151;
  }

  .po-modern p { margin: 2px 0; }

  /* ── Header ── */
  .po-modern .pm-hdr {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 24px;
  }

  .po-modern .pm-co-name {
    font-size: 12pt;
    font-weight: 700;
    color: #111827;
    margin-bottom: 3px;
  }

  .po-modern .pm-co-detail { font-size: 7.5pt; color: #9ca3af; }

  .po-modern .pm-doc-title {
    font-size: 20pt;
    font-weight: 300;
    color: #d1d5db;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: right;
    line-height: 1;
    margin-bottom: 6px;
  }

  .po-modern .pm-num {
    font-size: 13pt;
    font-weight: 700;
    color: #111827;
    text-align: right;
  }

  .po-modern .pm-date { font-size: 7.5pt; color: #9ca3af; text-align: right; margin-top: 2px; }

  /* ── Info Strip ── */
  .po-modern .pm-info {
    display: flex;
    gap: 0;
    margin-bottom: 24px;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
  }

  .po-modern .pm-info-col {
    flex: 1;
    padding: 12px 16px;
    border-right: 1px solid #e5e7eb;
    font-size: 8pt;
  }

  .po-modern .pm-info-col:first-child { padding-left: 0; }
  .po-modern .pm-info-col:last-child { border-right: none; }

  .po-modern .pm-info-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #9ca3af;
    margin-bottom: 6px;
  }

  .po-modern .pm-info-name { font-weight: 600; color: #111827; margin-bottom: 2px; }
  .po-modern .pm-info-dim { color: #9ca3af; font-size: 7.5pt; font-style: italic; }

  /* ── Table ── */
  .po-modern .pm-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 8.5pt;
  }

  .po-modern .pm-tbl th {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #9ca3af;
    padding: 0 10px 8px;
    text-align: left;
    border-bottom: 2px solid #e5e7eb;
  }

  .po-modern .pm-tbl th:nth-child(1) { width: 8%; text-align: center; }
  .po-modern .pm-tbl th:nth-child(4) { width: 80px; text-align: right; }
  .po-modern .pm-tbl th:nth-child(5) { width: 36px; text-align: center; }
  .po-modern .pm-tbl th:nth-child(6) { width: 90px; text-align: right; }

  .po-modern .pm-tbl td {
    padding: 8px 10px;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
    vertical-align: top;
  }

  .po-modern .pm-tbl td:nth-child(1) { text-align: center; color: #9ca3af; }
  .po-modern .pm-tbl td:nth-child(4) { text-align: right; }
  .po-modern .pm-tbl td:nth-child(5) { text-align: center; color: #9ca3af; }
  .po-modern .pm-tbl td:nth-child(6) { text-align: right; font-weight: 600; color: #111827; }

  /* ── Bottom: Notes + Totals ── */
  .po-modern .pm-bottom {
    display: flex;
    gap: 24px;
    margin-bottom: 20px;
  }

  .po-modern .pm-notes { flex: 1; }

  .po-modern .pm-notes-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #9ca3af;
    margin-bottom: 5px;
  }

  .po-modern .pm-notes-body { font-size: 8pt; color: #6b7280; line-height: 1.5; }

  .po-modern .pm-colour-tag {
    display: inline-block;
    font-size: 7pt;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 3px;
    padding: 1px 6px;
    margin: 2px 2px 2px 0;
    color: #374151;
  }

  .po-modern .pm-totals { width: 210px; flex-shrink: 0; }

  .po-modern .pm-tot-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 8pt;
    color: #6b7280;
    border-bottom: 1px solid #f3f4f6;
  }

  .po-modern .pm-tot-final {
    display: flex;
    justify-content: space-between;
    padding: 8px 0 4px;
    font-size: 10.5pt;
    font-weight: 700;
    color: #111827;
    border-top: 2px solid #111827;
    margin-top: 2px;
  }

  /* ── Footer ── */
  .po-modern .pm-remit {
    font-size: 7.5pt;
    color: #6b7280;
    padding: 10px 0;
    border-top: 1px solid #e5e7eb;
    margin-bottom: 10px;
  }

  .po-modern .pm-remit-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #9ca3af;
    margin-bottom: 4px;
  }

  .po-modern .pm-warn {
    font-size: 6.5pt;
    color: #b91c1c;
    font-weight: 600;
    padding: 5px 10px;
    background: #fff8f8;
    border-left: 3px solid #dc2626;
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .po-modern .pm-cond {
    font-size: 6.5pt;
    color: #9ca3af;
    border-top: 1px solid #f3f4f6;
    padding-top: 8px;
  }

  .po-modern .pm-cond-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #d1d5db;
    margin-bottom: 4px;
  }

  .po-modern .pm-cond ol { margin: 4px 0 0; padding-left: 14px; }
  .po-modern .pm-cond li { margin-bottom: 2px; }
</style>

<div class="po-modern">

  <!-- Header: Company left | PO title + number right -->
  <div class="pm-hdr">
    <div>
      <div class="pm-co-name"><%= company[:company_name] %></div>
      <div class="pm-co-detail">ABN <%= company[:abn_formatted] %><% if company[:qbcc_license].present? %> · QBCC <%= company[:qbcc_license] %><% end %></div>
      <div class="pm-co-detail"><%= company[:phone_formatted] %><% if company[:email].present? %> · <%= company[:email] %><% end %></div>
    </div>
    <div>
      <div class="pm-doc-title">Purchase Order</div>
      <div class="pm-num"><%= purchase_order[:purchase_order_number] %></div>
      <% if purchase_order[:ted_task].present? %><div class="pm-date"><%= purchase_order[:ted_task] %></div><% end %>
      <div class="pm-date">Required <%= purchase_order[:required_date] %></div>
    </div>
  </div>

  <!-- Info strip: Deliver To | Supplier | Site Contact -->
  <div class="pm-info">
    <div class="pm-info-col">
      <div class="pm-info-label">Deliver To</div>
      <div class="pm-info-name"><%= purchase_order[:delivery_address] || job[:full_address] %></div>
      <% if job[:suburb].present? %><p><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p><% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %><p class="pm-info-dim">Lot <%= job[:lot_number] %> · Plan <%= job[:plan_number] %></p><% end %>
    </div>
    <div class="pm-info-col">
      <div class="pm-info-label">Supplier</div>
      <div class="pm-info-name"><%= purchase_order[:supplier][:name] %></div>
      <% if purchase_order[:supplier][:phone].present? %><p><%= purchase_order[:supplier][:phone] %></p><% end %>
      <% if purchase_order[:supplier][:email].present? %><p><%= purchase_order[:supplier][:email] %></p><% end %>
    </div>
    <div class="pm-info-col">
      <div class="pm-info-label">Site Contact</div>
      <% if purchase_order[:site_supervisor][:name].present? %><div class="pm-info-name"><%= purchase_order[:site_supervisor][:name] %></div><% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %><p><%= purchase_order[:site_supervisor][:phone] %></p><% end %>
      <% if purchase_order[:site_supervisor][:email].present? %><p><%= purchase_order[:site_supervisor][:email] %></p><% end %>
      <p class="pm-info-dim">Ring 3 days prior to delivery</p>
    </div>
  </div>

  <!-- Line Items -->
  <table class="pm-tbl">
    <thead>
      <tr>
        <th>Qty</th>
        <th>Description</th>
        <th>Code</th>
        <th>Rate</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each do |item| %>
        <tr>
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace;font-size:7.5pt;color:#9ca3af"><%= item[:pricebook_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Notes + Colours + Totals -->
  <div class="pm-bottom">
    <div class="pm-notes">
      <div class="pm-notes-label">Notes</div>
      <div class="pm-notes-body">
        <% if purchase_order[:special_instructions].present? %>
          <%= purchase_order[:special_instructions] %>
        <% else %>
          <span style="color:#d1d5db;font-style:italic">No special instructions</span>
        <% end %>
      </div>

      <% if defined?(colour_selections) && colour_selections[:has_selections] %>
        <% filled = colour_selections[:flat_list].select { |s| s[:colour].present? } %>
        <% if filled.any? %>
          <div class="pm-notes-label" style="margin-top:10px">Colour Selections</div>
          <div>
            <% filled.each do |s| %>
              <span class="pm-colour-tag"><strong><%= s[:item].to_s.titleize %></strong>: <%= s[:colour] %><% if s[:brand].present? %> (<%= s[:brand] %>)<% end %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="pm-totals">
      <div class="pm-tot-row"><span>Sub Total</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:subtotal] %></span></div>
      <div class="pm-tot-row"><span>GST</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:gst] %></span></div>
      <div class="pm-tot-final"><span>Total (incl GST)</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:total] %></span></div>
    </div>
  </div>

  <!-- Remittance -->
  <div class="pm-remit">
    <div class="pm-remit-label">Remittance</div>
    Invoices to <strong><%= company[:company_name] %></strong> — <%= company[:email] %>.
    <% payment_days = purchase_order[:supplier][:payment_terms_days] %>
    <% if payment_days.present? && payment_days.to_i <= 14 %>
      <% if payment_days.to_i <= 7 %>
        &nbsp; <strong>7-day account:</strong> Invoices received before COB Wednesday paid the following Thursday.
      <% else %>
        &nbsp; <strong>14-day account:</strong> Invoices received before COB Wednesday paid Thursday two weeks later.
      <% end %>
    <% end %>
  </div>

  <!-- Warning -->
  <div class="pm-warn">
    The correct purchase order number and job address MUST be included on your tax invoice. Tax invoices without these details will be returned to the supplier for correction. Tax invoices exceeding the order total may delay payment.
  </div>

  <!-- Conditions -->
  <div class="pm-cond">
    <div class="pm-cond-label">Conditions of Acceptance</div>
    <ol>
      <li>If the purchase order is incorrect, please contact our office immediately.</li>
      <li>If additional work/items are required, then a NEW order number must be received.</li>
      <li>The correct purchase order number and job address MUST be included on your tax invoice. Tax invoices without these details will be returned to the supplier for correction.</li>
      <li>Processing of order will acknowledge acceptance of these conditions.</li>
      <li>In the instance the work is not completed by the original supplier in the specified timeframe, '<%= company[:company_name] %>' reserves the right to engage another supplier to complete the work. The new supplier will be paid from the original purchase order amount and any balance of funds will then be paid to the original supplier.</li>
      <li>Please ensure invoice is made out to <%= company[:company_name] %>.</li>
      <li>This purchase order is issued pursuant to the terms of the subcontract agreement. By accepting this purchase order you confirm that you agree to these subcontract terms.</li>
    </ol>
  </div>

</div>
