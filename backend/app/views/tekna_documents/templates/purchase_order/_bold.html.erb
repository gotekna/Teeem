<% # Executive Navy — Full-width dark header band. White body. Premium corporate style. %>
<%= "" -%>
<style>
  .po-bold {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    font-size: 9pt;
    line-height: 1.5;
    color: #1f2937;
  }

  .po-bold p { margin: 2px 0; }

  /* ── Header band ── */
  .po-bold .pb-hero {
    background: #1e3a5f;
    color: #fff;
    padding: 18px 20px 16px;
    margin: -15px -15px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  @media print {
    .po-bold .pb-hero { margin: -20mm -15mm 24px; padding: 18px 35px 16px; }
  }

  .po-bold .pb-hero-l { display: flex; gap: 14px; align-items: flex-start; }

  .po-bold .pb-logo-box {
    width: 44px;
    height: 44px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18pt;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    overflow: hidden;
  }

  .po-bold .pb-logo-box img { width: 100%; height: 100%; object-fit: contain; }

  .po-bold .pb-co-name { font-size: 12pt; font-weight: 700; color: #fff; line-height: 1.2; margin-bottom: 3px; }
  .po-bold .pb-co-detail { font-size: 7.5pt; color: rgba(255,255,255,0.6); }

  .po-bold .pb-hero-r { text-align: right; }
  .po-bold .pb-doc-label { font-size: 9pt; font-weight: 400; color: rgba(255,255,255,0.6); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 4px; }
  .po-bold .pb-num { font-size: 15pt; font-weight: 700; color: #fff; line-height: 1.1; }
  .po-bold .pb-date { font-size: 7.5pt; color: rgba(255,255,255,0.6); margin-top: 4px; }

  /* ── Info boxes ── */
  .po-bold .pb-info {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .po-bold .pb-info-col {
    flex: 1;
    border: 1px solid #e5e7eb;
    border-top: 3px solid #1e3a5f;
    padding: 10px 12px;
    font-size: 8pt;
  }

  .po-bold .pb-info-hd {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #1e3a5f;
    margin-bottom: 6px;
    padding-bottom: 5px;
    border-bottom: 1px solid #f3f4f6;
  }

  .po-bold .pb-info-name { font-weight: 600; color: #111827; margin-bottom: 2px; }
  .po-bold .pb-info-dim { color: #9ca3af; font-size: 7.5pt; font-style: italic; margin-top: 3px; }

  /* ── Line items table ── */
  .po-bold .pb-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 8.5pt;
  }

  .po-bold .pb-tbl th {
    background: #1e3a5f;
    color: #fff;
    padding: 7px 10px;
    font-size: 7pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: left;
  }

  .po-bold .pb-tbl th:nth-child(1) { width: 40px; text-align: center; }
  .po-bold .pb-tbl th:nth-child(4) { width: 80px; text-align: right; }
  .po-bold .pb-tbl th:nth-child(5) { width: 36px; text-align: center; }
  .po-bold .pb-tbl th:nth-child(6) { width: 90px; text-align: right; }

  .po-bold .pb-tbl td {
    padding: 7px 10px;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: top;
    color: #374151;
  }

  .po-bold .pb-tbl td:nth-child(1) { text-align: center; font-weight: 600; color: #6b7280; }
  .po-bold .pb-tbl td:nth-child(4) { text-align: right; }
  .po-bold .pb-tbl td:nth-child(5) { text-align: center; color: #9ca3af; }
  .po-bold .pb-tbl td:nth-child(6) { text-align: right; font-weight: 700; color: #111827; }

  .po-bold .pb-alt td { background: #f8fafc; }

  /* ── Bottom: Notes + Totals ── */
  .po-bold .pb-bottom {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
    align-items: flex-start;
  }

  .po-bold .pb-notes { flex: 1; }

  .po-bold .pb-sec-label {
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #1e3a5f;
    margin-bottom: 5px;
  }

  .po-bold .pb-notes-body { font-size: 8pt; color: #4b5563; line-height: 1.5; }

  .po-bold .pb-colour-tag {
    display: inline-block;
    font-size: 7pt;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 3px;
    padding: 1px 6px;
    margin: 2px 2px 2px 0;
    color: #1e40af;
  }

  .po-bold .pb-totals { width: 200px; flex-shrink: 0; }

  .po-bold .pb-tot-line {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 8pt;
    color: #6b7280;
    border-bottom: 1px solid #f0f0f0;
  }

  .po-bold .pb-tot-total {
    display: flex;
    justify-content: space-between;
    padding: 8px 0 4px;
    font-size: 11pt;
    font-weight: 700;
    color: #1e3a5f;
    border-top: 2px solid #1e3a5f;
    margin-top: 2px;
  }

  /* ── Footer ── */
  .po-bold .pb-remit {
    font-size: 7.5pt;
    color: #6b7280;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-left: 3px solid #1e3a5f;
    border-radius: 2px;
    margin-bottom: 10px;
  }

  .po-bold .pb-warn {
    font-size: 6.5pt;
    color: #b91c1c;
    font-weight: 600;
    background: #fff8f8;
    border-left: 3px solid #dc2626;
    padding: 5px 10px;
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .po-bold .pb-cond {
    font-size: 6.5pt;
    color: #9ca3af;
    border-top: 1px solid #f0f0f0;
    padding-top: 8px;
  }

  .po-bold .pb-cond ol { margin: 4px 0 0; padding-left: 14px; }
  .po-bold .pb-cond li { margin-bottom: 2px; }
</style>

<div class="po-bold">

  <!-- Dark header band -->
  <div class="pb-hero">
    <div class="pb-hero-l">
      <div class="pb-logo-box">
        <% if company[:logo_url].present? %>
          <img src="<%= company[:logo_url] %>" alt="<%= company[:company_name] %>">
        <% else %>
          <%= company[:company_name].to_s.first.upcase %>
        <% end %>
      </div>
      <div>
        <div class="pb-co-name"><%= company[:company_name] %></div>
        <div class="pb-co-detail">ABN <%= company[:abn_formatted] %><% if company[:qbcc_license].present? %> · QBCC <%= company[:qbcc_license] %><% end %></div>
        <div class="pb-co-detail"><%= company[:phone_formatted] %><% if company[:email].present? %> · <%= company[:email] %><% end %></div>
      </div>
    </div>
    <div class="pb-hero-r">
      <div class="pb-doc-label">Purchase Order</div>
      <div class="pb-num"><%= purchase_order[:purchase_order_number] %></div>
      <% if purchase_order[:ted_task].present? %><div class="pb-date"><%= purchase_order[:ted_task] %></div><% end %>
      <div class="pb-date">Required <%= purchase_order[:required_date] %></div>
    </div>
  </div>

  <!-- Info boxes with navy top border -->
  <div class="pb-info">
    <div class="pb-info-col">
      <div class="pb-info-hd">Deliver To</div>
      <div class="pb-info-name"><%= purchase_order[:delivery_address] || job[:full_address] %></div>
      <% if job[:suburb].present? %><p><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p><% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %><p class="pb-info-dim">Lot <%= job[:lot_number] %> · Plan <%= job[:plan_number] %></p><% end %>
    </div>
    <div class="pb-info-col">
      <div class="pb-info-hd">Supplier</div>
      <div class="pb-info-name"><%= purchase_order[:supplier][:name] %></div>
      <% if purchase_order[:supplier][:phone].present? %><p><%= purchase_order[:supplier][:phone] %></p><% end %>
      <% if purchase_order[:supplier][:email].present? %><p><%= purchase_order[:supplier][:email] %></p><% end %>
    </div>
    <div class="pb-info-col">
      <div class="pb-info-hd">Site Contact</div>
      <% if purchase_order[:site_supervisor][:name].present? %><div class="pb-info-name"><%= purchase_order[:site_supervisor][:name] %></div><% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %><p><%= purchase_order[:site_supervisor][:phone] %></p><% end %>
      <% if purchase_order[:site_supervisor][:email].present? %><p><%= purchase_order[:site_supervisor][:email] %></p><% end %>
      <p class="pb-info-dim">Ring 3 days prior to delivery</p>
    </div>
  </div>

  <!-- Line Items -->
  <table class="pb-tbl">
    <thead>
      <tr>
        <th>QTY</th>
        <th>Description</th>
        <th>Code</th>
        <th>Rate</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each_with_index do |item, index| %>
        <tr class="<%= index.odd? ? 'pb-alt' : '' %>">
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace;font-size:7.5pt;color:#9ca3af"><%= item[:pricebook_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Notes + Colours + Totals -->
  <div class="pb-bottom">
    <div class="pb-notes">
      <div class="pb-sec-label">Notes</div>
      <div class="pb-notes-body">
        <% if purchase_order[:special_instructions].present? %>
          <%= purchase_order[:special_instructions] %>
        <% else %>
          <span style="color:#d1d5db;font-style:italic">No special instructions</span>
        <% end %>
      </div>

      <% if defined?(colour_selections) && colour_selections[:has_selections] %>
        <% filled = colour_selections[:flat_list].select { |s| s[:colour].present? } %>
        <% if filled.any? %>
          <div class="pb-sec-label" style="margin-top:10px">Colour Selections</div>
          <div>
            <% filled.each do |s| %>
              <span class="pb-colour-tag"><strong><%= s[:item].to_s.titleize %></strong>: <%= s[:colour] %><% if s[:brand].present? %> (<%= s[:brand] %>)<% end %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="pb-totals">
      <div class="pb-tot-line"><span>Sub Total</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:subtotal] %></span></div>
      <div class="pb-tot-line"><span>GST</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:gst] %></span></div>
      <div class="pb-tot-total"><span>Total (incl GST)</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:total] %></span></div>
    </div>
  </div>

  <!-- Remittance -->
  <div class="pb-remit">
    <div class="pb-sec-label">Remittance</div>
    Invoices to <strong><%= company[:company_name] %></strong> — <%= company[:email] %>
    <% payment_days = purchase_order[:supplier][:payment_terms_days] %>
    <% if payment_days.present? && payment_days.to_i <= 14 %>
      <div style="margin-top:2px">
        <% if payment_days.to_i <= 7 %>
          <strong>7-day account:</strong> Invoices received before COB Wednesday paid the following Thursday.
        <% else %>
          <strong>14-day account:</strong> Invoices received before COB Wednesday paid Thursday two weeks later.
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Warning -->
  <div class="pb-warn">
    The correct purchase order number and job address MUST be included on your tax invoice. Tax invoices without these details will be returned to the supplier for correction. Tax invoices exceeding the order total may delay payment.
  </div>

  <!-- Conditions -->
  <div class="pb-cond">
    <div style="font-size:6.5pt;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#9ca3af;margin-bottom:4px">Conditions of Acceptance</div>
    <ol>
      <li>If the purchase order is incorrect, please contact our office immediately.</li>
      <li>If additional work/items are required, then a NEW order number must be received.</li>
      <li>The correct purchase order number and job address MUST be included on your tax invoice. Tax invoices without these details will be returned to the supplier for correction.</li>
      <li>Processing of order will acknowledge acceptance of these conditions.</li>
      <li>In the instance the work is not completed by the original supplier in the specified timeframe, '<%= company[:company_name] %>' reserves the right to engage another supplier to complete the work. The new supplier will be paid from the original purchase order amount and any balance of funds will then be paid to the original supplier.</li>
      <li>Please ensure invoice is made out to <%= company[:company_name] %>.</li>
      <li>This purchase order is issued pursuant to the terms of the subcontract agreement. By accepting this purchase order you confirm that you agree to these subcontract terms.</li>
    </ol>
  </div>

</div>
