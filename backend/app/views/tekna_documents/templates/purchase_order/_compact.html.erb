<% # Compact Efficient — Small fonts, tight spacing. Professional density. Fits maximum line items per page. %>
<%= "" -%>
<style>
  .po-compact {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    font-size: 8pt;
    line-height: 1.3;
    color: #1f2937;
  }

  .po-compact p { margin: 1px 0; }

  /* ── Header ── */
  .po-compact .pc-hdr {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid #374151;
  }

  .po-compact .pc-co-name { font-size: 11pt; font-weight: 700; color: #111827; margin-bottom: 2px; }
  .po-compact .pc-co-detail { font-size: 6.5pt; color: #9ca3af; }

  .po-compact .pc-hdr-r { text-align: right; }
  .po-compact .pc-doc-label {
    font-size: 8.5pt;
    font-weight: 400;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }
  .po-compact .pc-num { font-size: 12pt; font-weight: 700; color: #111827; }
  .po-compact .pc-date { font-size: 6.5pt; color: #9ca3af; margin-top: 2px; }

  /* ── Info row — compact three-column bordered grid ── */
  .po-compact .pc-info {
    display: flex;
    gap: 0;
    margin-bottom: 10px;
    border: 1px solid #e5e7eb;
  }

  .po-compact .pc-info-col {
    flex: 1;
    padding: 6px 8px;
    border-right: 1px solid #e5e7eb;
    font-size: 7pt;
  }

  .po-compact .pc-info-col:last-child { border-right: none; }

  .po-compact .pc-info-hd {
    font-size: 6pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: #6b7280;
    margin-bottom: 3px;
    padding-bottom: 2px;
    border-bottom: 1px solid #f3f4f6;
  }

  .po-compact .pc-info-name { font-weight: 600; color: #111827; }
  .po-compact .pc-info-dim { color: #9ca3af; font-size: 6.5pt; font-style: italic; }

  /* ── Table ── */
  .po-compact .pc-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 8px;
    font-size: 7.5pt;
  }

  .po-compact .pc-tbl th {
    background: #374151;
    color: #fff;
    padding: 4px 6px;
    font-size: 6.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    text-align: left;
  }

  .po-compact .pc-tbl th:nth-child(1) { width: 36px; text-align: center; }
  .po-compact .pc-tbl th:nth-child(4) { width: 70px; text-align: right; }
  .po-compact .pc-tbl th:nth-child(5) { width: 30px; text-align: center; }
  .po-compact .pc-tbl th:nth-child(6) { width: 80px; text-align: right; }

  .po-compact .pc-tbl td {
    padding: 3px 6px;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: top;
    color: #374151;
  }

  .po-compact .pc-tbl td:nth-child(1) { text-align: center; color: #9ca3af; }
  .po-compact .pc-tbl td:nth-child(4) { text-align: right; }
  .po-compact .pc-tbl td:nth-child(5) { text-align: center; color: #9ca3af; }
  .po-compact .pc-tbl td:nth-child(6) { text-align: right; font-weight: 600; }

  .po-compact .pc-alt td { background: #fafafa; }

  /* ── Bottom: Notes + Totals ── */
  .po-compact .pc-bottom {
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
    align-items: flex-start;
  }

  .po-compact .pc-notes { flex: 1; }
  .po-compact .pc-notes-label { font-size: 6pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.7px; color: #9ca3af; margin-bottom: 3px; }
  .po-compact .pc-notes-body { font-size: 7.5pt; color: #4b5563; line-height: 1.4; }

  .po-compact .pc-totals { width: 180px; flex-shrink: 0; }

  .po-compact .pc-tot-row {
    display: flex;
    justify-content: space-between;
    padding: 2px 0;
    font-size: 7.5pt;
    color: #6b7280;
    border-bottom: 1px solid #f3f4f6;
  }

  .po-compact .pc-tot-final {
    display: flex;
    justify-content: space-between;
    padding: 5px 0 3px;
    font-size: 9.5pt;
    font-weight: 700;
    color: #111827;
    border-top: 2px solid #374151;
    margin-top: 1px;
  }

  /* ── Colour row ── */
  .po-compact .pc-colour {
    font-size: 7pt;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 4px 8px;
    margin-bottom: 7px;
  }

  .po-compact .pc-colour-label { font-weight: 700; color: #374151; margin-right: 4px; }

  /* ── Footer ── */
  .po-compact .pc-remit {
    font-size: 6.5pt;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
    padding-top: 5px;
    margin-bottom: 7px;
  }

  .po-compact .pc-remit-label { font-weight: 700; color: #374151; margin-right: 4px; }

  .po-compact .pc-warn {
    font-size: 6.5pt;
    color: #b91c1c;
    font-weight: 600;
    padding: 4px 8px;
    background: #fff8f8;
    border-left: 3px solid #dc2626;
    margin-bottom: 7px;
  }

  .po-compact .pc-cond {
    font-size: 6pt;
    color: #9ca3af;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 6px 8px;
    column-count: 2;
    column-gap: 14px;
  }

  .po-compact .pc-cond-label {
    font-size: 6pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: #6b7280;
    margin-bottom: 3px;
    column-span: all;
  }

  .po-compact .pc-cond ol { margin: 0; padding-left: 11px; }
  .po-compact .pc-cond li { margin-bottom: 1px; }
</style>

<div class="po-compact">

  <!-- Header -->
  <div class="pc-hdr">
    <div>
      <div class="pc-co-name"><%= company[:company_name] %></div>
      <div class="pc-co-detail">ABN <%= company[:abn_formatted] %><% if company[:qbcc_license].present? %> · QBCC <%= company[:qbcc_license] %><% end %></div>
      <div class="pc-co-detail"><%= company[:phone_formatted] %><% if company[:email].present? %> · <%= company[:email] %><% end %></div>
    </div>
    <div class="pc-hdr-r">
      <div class="pc-doc-label">Purchase Order</div>
      <div class="pc-num"><%= purchase_order[:purchase_order_number] %></div>
      <% if purchase_order[:ted_task].present? %><div class="pc-date"><%= purchase_order[:ted_task] %></div><% end %>
      <div class="pc-date">Required <%= purchase_order[:required_date] %></div>
    </div>
  </div>

  <!-- Compact info row -->
  <div class="pc-info">
    <div class="pc-info-col">
      <div class="pc-info-hd">Deliver To</div>
      <div class="pc-info-name"><%= purchase_order[:delivery_address] || job[:full_address] %></div>
      <% if job[:suburb].present? %><p><%= job[:suburb] %> <%= job[:state] %> <%= job[:postcode] %></p><% end %>
      <% if job[:lot_number].present? || job[:plan_number].present? %><p class="pc-info-dim">Lot <%= job[:lot_number] %> · Plan <%= job[:plan_number] %></p><% end %>
    </div>
    <div class="pc-info-col">
      <div class="pc-info-hd">Supplier</div>
      <div class="pc-info-name"><%= purchase_order[:supplier][:name] %></div>
      <% if purchase_order[:supplier][:phone].present? %><p><%= purchase_order[:supplier][:phone] %></p><% end %>
      <% if purchase_order[:supplier][:email].present? %><p><%= purchase_order[:supplier][:email] %></p><% end %>
    </div>
    <div class="pc-info-col">
      <div class="pc-info-hd">Site Contact</div>
      <% if purchase_order[:site_supervisor][:name].present? %><div class="pc-info-name"><%= purchase_order[:site_supervisor][:name] %></div><% end %>
      <% if purchase_order[:site_supervisor][:phone].present? %><p><%= purchase_order[:site_supervisor][:phone] %></p><% end %>
      <% if purchase_order[:site_supervisor][:email].present? %><p><%= purchase_order[:site_supervisor][:email] %></p><% end %>
      <p class="pc-info-dim">Ring 3 days prior</p>
    </div>
  </div>

  <!-- Line Items -->
  <table class="pc-tbl">
    <thead>
      <tr>
        <th>QTY</th>
        <th>Description</th>
        <th>Code</th>
        <th>Rate</th>
        <th>Tax</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% purchase_order[:line_items].each_with_index do |item, index| %>
        <tr class="<%= index.odd? ? 'pc-alt' : '' %>">
          <td><%= item[:quantity] %></td>
          <td><%= item[:description] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace;color:#9ca3af"><%= item[:pricebook_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:unit_price_formatted] %></td>
          <td><%= item[:gst_code] %></td>
          <td style="font-family:'SF Mono',Menlo,monospace"><%= item[:total_formatted] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Notes + Totals -->
  <div class="pc-bottom">
    <div class="pc-notes">
      <% if purchase_order[:special_instructions].present? %>
        <div class="pc-notes-label">Notes</div>
        <div class="pc-notes-body"><%= purchase_order[:special_instructions] %></div>
      <% end %>
    </div>
    <div class="pc-totals">
      <div class="pc-tot-row"><span>Sub Total</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:subtotal] %></span></div>
      <div class="pc-tot-row"><span>GST</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:gst] %></span></div>
      <div class="pc-tot-final"><span>Total (incl GST)</span><span style="font-family:'SF Mono',Menlo,monospace"><%= purchase_order[:total] %></span></div>
    </div>
  </div>

  <!-- Colour Selections -->
  <% if defined?(colour_selections) && colour_selections[:has_selections] %>
    <% filled = colour_selections[:flat_list].select { |s| s[:colour].present? } %>
    <% if filled.any? %>
      <div class="pc-colour">
        <span class="pc-colour-label">Colours:</span>
        <% filled.each_with_index do |s, i| %>
          <strong><%= s[:item].to_s.titleize %></strong>: <%= s[:colour] %><% if s[:brand].present? %> (<%= s[:brand] %>)<% end %><%= i < filled.size - 1 ? " · " : "" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <!-- Remittance -->
  <div class="pc-remit">
    <span class="pc-remit-label">Remittance:</span>
    Invoices to <%= company[:company_name] %> · <%= company[:email] %>
    <% payment_days = purchase_order[:supplier][:payment_terms_days] %>
    <% if payment_days.present? && payment_days.to_i <= 14 %>
      <% if payment_days.to_i <= 7 %>
        · <strong>7-day:</strong> paid following Thursday
      <% else %>
        · <strong>14-day:</strong> paid Thursday two weeks later
      <% end %>
    <% end %>
    · PO number and job address MUST appear on invoice.
  </div>

  <!-- Warning -->
  <div class="pc-warn">
    Purchase order number and job address MUST be on tax invoice. Invoices without these details will be returned. Invoices exceeding order total may delay payment.
  </div>

  <!-- Conditions (2-column) -->
  <div class="pc-cond">
    <div class="pc-cond-label">Conditions of Acceptance</div>
    <ol>
      <li>If incorrect, contact our office immediately.</li>
      <li>Additional work requires a NEW order number.</li>
      <li>PO number and job address MUST appear on your tax invoice.</li>
      <li>Processing of order acknowledges acceptance of these conditions.</li>
      <li>'<%= company[:company_name] %>' reserves the right to engage another supplier if work is not completed in the specified timeframe.</li>
      <li>Invoice must be made out to <%= company[:company_name] %>.</li>
      <li>This PO is issued pursuant to the terms of the subcontract agreement.</li>
    </ol>
  </div>

</div>
