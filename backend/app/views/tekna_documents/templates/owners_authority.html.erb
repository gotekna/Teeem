<h1>Owner's Authority to Obtain Information</h1>

<p style="color: var(--color-text-secondary);">
  Job: <%= @job[:job_number] %> | <%= @job[:name] %><br>
  Date: <%= format_date(today, :long) %>
</p>

<h2>Property Details</h2>

<table>
  <tr>
    <td style="width: 35%; background: #f5f5f5;"><strong>Site Address</strong></td>
    <td><%= @job[:full_address] %></td>
  </tr>
  <% if @job[:lot_number].present? %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Lot/Plan</strong></td>
    <td>Lot <%= @job[:lot_number] %> on Plan <%= @job[:plan_number] %></td>
  </tr>
  <% end %>
</table>

<h2>Owner Details</h2>

<table>
  <tr>
    <td style="width: 35%; background: #f5f5f5;"><strong>Owner Name(s)</strong></td>
    <td><%= @client_names %></td>
  </tr>
  <% if @client_1.present? && @client_1[:address].present? %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Address</strong></td>
    <td><%= @client_1[:full_address] %></td>
  </tr>
  <% end %>
  <% if @client_1.present? && @client_1[:phone].present? %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Phone</strong></td>
    <td><%= @client_1[:phone] %></td>
  </tr>
  <% end %>
  <% if @client_1.present? && @client_1[:email].present? %>
  <tr>
    <td style="background: #f5f5f5;"><strong>Email</strong></td>
    <td><%= @client_1[:email] %></td>
  </tr>
  <% end %>
</table>

<h2>Authority</h2>

<p>
  I/We, <strong><%= @client_names %></strong>, being the registered owner(s) of the
  property described above, hereby authorise <strong><%= @company[:name] %></strong>
  (QBCC Licence No. <%= @company[:qbcc_license] %>) to:
</p>

<ol>
  <li>
    Obtain any information from the relevant local council or authority relating to
    the above property, including but not limited to:
    <ul style="margin-top: var(--space-2);">
      <li>Property searches and rates information</li>
      <li>Building and planning approvals</li>
      <li>Development applications and conditions</li>
      <li>Infrastructure charges and requirements</li>
      <li>Easements and encumbrances</li>
    </ul>
  </li>
  <li>
    Make enquiries and obtain information from utility providers regarding services
    to the property including water, sewerage, electricity, gas, and telecommunications.
  </li>
  <li>
    Obtain soil tests, surveys, and other site investigations as required for the
    construction of the dwelling.
  </li>
  <li>
    Submit applications and obtain approvals on my/our behalf as required for the
    construction of the dwelling.
  </li>
</ol>

<p>
  This authority remains in force until the completion of the building works or until
  revoked in writing by me/us.
</p>

<%= render "signature_block" %>
