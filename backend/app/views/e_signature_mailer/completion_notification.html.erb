<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #16a34a; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
    .content { background: #f8fafc; padding: 30px; border-radius: 0 0 8px 8px; }
    .details { background: white; padding: 15px; border-radius: 6px; margin: 15px 0; }
    .signer { padding: 8px 0; border-bottom: 1px solid #e2e8f0; }
    .signer:last-child { border-bottom: none; }
    .footer { text-align: center; color: #64748b; font-size: 12px; margin-top: 20px; }
    .checkmark { font-size: 48px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="checkmark">✓</div>
      <h1>Signing Complete</h1>
    </div>
    <div class="content">
      <p>All signatures have been collected for:</p>

      <div class="details">
        <p><strong>Document:</strong> <%= @request.title %></p>
        <p><strong>Request Number:</strong> <%= @request.request_number %></p>
        <% if @certificate %>
          <p><strong>Certificate Number:</strong> <%= @certificate.certificate_number %></p>
        <% end %>
        <p><strong>Completed:</strong> <%= @request.completed_at&.strftime("%d %B %Y at %I:%M %p") %></p>
      </div>

      <h3>Signers</h3>
      <div class="details">
        <% @request.signers.signed.each do |signer| %>
          <div class="signer">
            <strong><%= signer.name %></strong><br>
            <span style="color: #64748b;"><%= signer.email %></span><br>
            <span style="color: #16a34a; font-size: 12px;">Signed <%= signer.signed_at&.strftime("%d %b %Y at %I:%M %p") %></span>
          </div>
        <% end %>
      </div>

      <p style="text-align: center; font-size: 14px; color: #64748b;">
        The signed document and certificate of completion are available in the TEEEM system.
      </p>
    </div>
    <div class="footer">
      <p>This is an automated message from TEEEM E-Signature System.</p>
    </div>
  </div>
</body>
</html>
