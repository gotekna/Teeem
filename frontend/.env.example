# =============================================================================
# TEEEM FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update for your environment:
#   cp .env.example .env
#
# See ENVIRONMENT_SETUP.md for detailed setup instructions.

# -----------------------------------------------------------------------------
# BACKEND API URL - CRITICAL
# -----------------------------------------------------------------------------
# The backend API URL where the React frontend will send all API requests
#
# Development (local backend running):
#   http://localhost:3000
#
# Production (Heroku backend):
#   https://teeem-backend-447058022b51.herokuapp.com
#
# Note: Make sure the backend CORS configuration allows requests from your frontend URL
# Backend CORS is configured in: backend/config/initializers/cors.rb
VITE_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MAPBOX API - REQUIRED FOR ADDRESS SEARCH (FREE TIER)
# -----------------------------------------------------------------------------
# Required for: Address autocomplete and geocoding in job locations
#
# Setup instructions:
# 1. Go to https://account.mapbox.com/auth/signup/
# 2. Sign up for a free account
# 3. Go to https://account.mapbox.com/access-tokens/
# 4. Copy your default public access token (or create a new one)
# 5. Paste it below
#
# Free tier includes:
# - 100,000 geocoding requests/month (way more than you'll need!)
# - No credit card required for free tier
# - Excellent Australian address coverage
# - Professional autocomplete experience
#
# More info: https://docs.mapbox.com/api/search/geocoding/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# -----------------------------------------------------------------------------
# SENTRY - ERROR TRACKING AND MONITORING (OPTIONAL)
# -----------------------------------------------------------------------------
# Sentry provides error tracking, performance monitoring, and session replay
#
# Setup instructions:
# 1. Go to https://sentry.io/signup/
# 2. Create a free account (supports up to 5,000 errors/month)
# 3. Create a new project and select "React" as the platform
# 4. Copy the DSN (Data Source Name) from the project settings
# 5. Paste it below
#
# Leave blank to disable Sentry error tracking
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# DEBUG FLAGS - CONTROL CONSOLE VERBOSITY (OPTIONAL)
# -----------------------------------------------------------------------------
# These flags control which debug logs appear in the console during development
# All flags default to 'false' if not set
#
# VITE_DEBUG_PROGRESSIVE_LOADING - Shows progressive loading details
#   (views loading, records loading, background loads, preload cache hits)
#
# VITE_DEBUG_PROGRESS_SYNC - Shows progress synchronization details
#   (state updates, rendering phases, timer cleanup)
#
# VITE_DEBUG_ALL - Enables all debug flags at once
#
# Recommended settings:
#   Development (normal): Leave all commented out (quiet console)
#   Debugging tables: VITE_DEBUG_PROGRESSIVE_LOADING=true
#   Debugging performance: VITE_DEBUG_PROGRESS_SYNC=true
#   Full debugging: VITE_DEBUG_ALL=true
#
# VITE_DEBUG_PROGRESSIVE_LOADING=false
# VITE_DEBUG_PROGRESS_SYNC=false
# VITE_DEBUG_ALL=false
